# Native-brain local dev config (Tier 0–3 of the agent-loop spec).
#
# Copy to config/config.dev.toml (gitignored) and point CLI invocations at it:
#   uv run istota task "..." -u dev -x -c config/config.dev.toml
#   uv run python scripts/native_repl.py -c config/config.dev.toml --provider live "..."
#
# The API key NEVER goes in this file. Provide it as the provider's variable
# (ISTOTA_PROVIDER_ANTHROPIC_API_KEY), e.g. through direnv/.env, or as a key
# of the dev user's own:
#   istota secret ensure -u dev -s provider_keys -k anthropic -v sk-...

[brain]
kind = "native"

[brain.native]
provider = "anthropic"                 # built in: https://api.anthropic.com
model = "sonnet"                       # a family alias, or an id the provider lists
max_turns = 50

# Zero-cost live loop: point native at a local Ollama model instead, as a
# provider of your own. Quality is lower (small models loop / mis-call tools —
# useful for shaking out the loop detector and JSON repair), but it validates
# the whole stack offline.
# [brain.native]
# provider = "ollama"
# model = "qwen3:32b"
#
# [providers.ollama]
# kind = "openai_compat"
# base_url = "http://localhost:11434/v1"
# models = [ { id = "qwen3:32b", context_window = 32768 } ]

[security]
sandbox_enabled = false                # bwrap is Linux-only; off for mac dev
skill_proxy_enabled = false            # simplifies the inner loop; re-enable to test isolation

[users.dev]
display_name = "Dev"
