# {{ ansible_managed }}
# Per-user devbox credential proxy. One systemd instance per devbox user;
# the %i instance specifier is the user_id, which the daemon uses as its
# audit-log key and the suffix of the socket path it listens on.
#
# Tokens are read from the EnvironmentFile and held only in this process's
# memory until an authenticated container client requests one. The proxy
# socket lives under /var/run/{namespace}/<user>/sock; the compose
# template bind-mounts that per-user directory (not the file) into the
# container at /run/istota-cred so a daemon restart can recreate the
# socket inode without stranding the container against a dead inode.

[Unit]
Description=Istota devbox credential proxy ({{ istota_namespace }}, user %i)
After=network.target
# The listener may start before Docker. Each connection checks the current
# container identity through the local Docker CLI and refuses if unavailable.

[Service]
Type=simple
User={{ istota_user }}
Group={{ istota_group }}
WorkingDirectory={{ istota_home }}
Environment="ISTOTA_ADMINS_FILE=/etc/{{ istota_namespace }}/admins"
EnvironmentFile=/etc/{{ istota_namespace }}/secrets.env
ExecStart={{ istota_home }}/.venv/bin/python -m {{ istota_package }}.devbox_proxy --user %i --config {{ istota_repo_dir }}/config/config.toml
Restart=on-failure
RestartSec=5s
# Limit blast radius. The proxy needs to read tokens, write to its socket
# dir, inspect the local container through Docker, read host /proc cgroups,
# and write to the audit log.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
