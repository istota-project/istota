[Unit]
Description={{ istota_namespace | capitalize }} Task Scheduler Daemon
After=network.target
{% if istota_use_nextcloud_mount %}
After=mount-nextcloud.service
# Requires (not Wants): if the rclone mount is down, the scheduler must NOT
# start. A weak Wants let it boot while the mount was failing and seed per-user
# workspace data into the bare mountpoint, which then permanently wedged rclone
# ("mountpoint is not empty"). With the mount unit as Type=notify, After= also
# guarantees we start only once the FUSE mount is actually live, not just spawned.
Requires=mount-nextcloud.service
{% endif %}

[Service]
Type=simple
User={{ istota_user }}
Group={{ istota_group }}
WorkingDirectory={{ istota_repo_dir }}
ExecStart={{ istota_home }}/.venv/bin/python -m {{ istota_package }}.scheduler --daemon --config {{ istota_repo_dir }}/config/config.toml
Restart=always
RestartSec=5

# Signal only the main process on stop. systemd's default
# KillMode=control-group SIGTERMs *every* process in the cgroup, so a
# `systemctl restart` (the auto-update cron issues one on every new commit)
# killed in-flight tasks' `claude` subprocesses out from under their workers.
# The daemon shut down gracefully, so the surviving worker recorded the corpse
# as an ordinary task failure — and on a final attempt, as a permanent one
# (ISSUE-191). With mixed, the daemon owns the shutdown: workers get their
# drain window, and anything still alive when the main process exits is
# SIGKILLed by systemd's cleanup, leaving `running` rows for
# recover_orphaned_tasks_on_startup to requeue on the next boot.
KillMode=mixed

# FD ceiling. The scheduler holds many concurrent SQLite connections
# (framework istota.db + per-user feeds.db + per-user location.db, each
# WAL-mode → main + -wal + -shm), spawns claude CLI subprocesses with
# stream-json pipes, and runs Talk/email/heartbeat pollers. The systemd
# default of 1024 has produced "unable to open database file" + httpx
# "All connection attempts failed" bursts (EMFILE).
LimitNOFILE=65536

# Resource limits (host-and-scheduler-robustness spec, Track A).
#
# MemoryHigh, deliberately not MemoryMax: past the limit the kernel puts this
# cgroup under heavy reclaim pressure and slows it down, where a hard cap would
# OOM-kill it outright. What that buys is that istota's own growth self-limits
# before the host reaches global OOM. What it costs is that the daemon can get
# slow rather than failing loudly, so a genuine leak here shows up as latency
# first. That trade is the right way round: killing the daemon takes down every
# user's tasks, the web UI and the pollers at once. Note honestly that nothing
# in the 2026-08-20 incident showed istota exceeding a sane budget — its whole
# footprint was around 1.2 GB — so this is a guard against a future regression,
# not a fix for the observed failure.
#
# Sizing note, because the obvious number is the wrong one: this applies to the
# WHOLE cgroup, not the daemon. Every `claude` subprocess and everything those
# spawn is inside it. At user_max_foreground_workers = 2 that is roughly
# 1.2 GB daemon + 2 x ~0.5 GB claude + whatever a task's own build or test run
# costs, and the incident's own workload (a full pytest suite under xdist)
# clears 3 GB on its own. The spec's 3G was picked against the daemon
# footprint alone. Set too low, memory.high does not fail — it applies an
# allocation-time sleep penalty to every process in the cgroup, including the
# dispatch loop and the Talk poller, so the symptom is "everything gets slow
# and nothing logs", which is indistinguishable from the hang this whole spec
# exists to fix. Hence 5G: high enough not to throttle ordinary work on a
# 7.9 GB box, low enough to catch a genuine runaway before the host does.
# Nothing reads memory.events yet, so a throttle is currently invisible —
# Stage 3 should have host_pressure surface the `high` counter.
{% if istota_scheduler_memory_high %}
MemoryHigh={{ istota_scheduler_memory_high }}
{% endif %}

# CPUWeight below the systemd default of 100, so every other unit on the box
# wins under contention. What it buys is that a runaway test suite under a task
# yields to sshd and nginx, which is the difference between a slow host and an
# unreachable one. What it costs is nothing while the machine is idle — weight
# only applies when something else actually wants the CPU. A hard CPUQuota is
# deliberately *not* set here: PSI recorded `cpu full avg10=0` against
# `memory full avg10=60` during the incident, so the cores were idle-waiting on
# memory rather than oversubscribed, and a quota would have slowed legitimate
# work without preventing the outage.
{% if istota_scheduler_cpu_weight %}
CPUWeight={{ istota_scheduler_cpu_weight }}
{% endif %}

# Accounting is implied by MemoryHigh, but Stage 5's per-task cgroups depend on
# it and a directive another feature relies on should be visible in the unit
# rather than an inherited side effect of a different one.
MemoryAccounting=yes

# Delegate hands this unit's cgroup subtree to its own User=, which is what
# lets the daemon create a cgroup per task and cap it there. What it buys is
# that a task tree exceeding its budget is OOM-killed *inside its own cgroup* —
# one failed task instead of a global OOM that picks an unrelated victim (the
# incident's OOM killer chose chrome eight times and reclaimed almost nothing
# each time, because chrome was never the consumer). What it costs is that
# systemd stops managing the sub-hierarchy and chowns it to the service user.
# Inert until Stage 5 creates a cgroup; the executor fails open when the
# subtree is not delegated, so a host still running the previous unit file
# keeps working.
Delegate=memory pids cpu

# Delegate= alone is NOT enough, and the gap is silent. cgroup v2 forbids a
# non-root cgroup from both holding processes and enabling controllers for its
# children — the write to cgroup.subtree_control returns EBUSY. This unit is
# Type=simple, so the daemon's own process sits directly in the unit cgroup,
# and Stage 5 would create task-<id>/ successfully and then find no memory.max
# inside it. A6's fail-open rule would swallow that, so containment would never
# engage and nothing would report it. DelegateSubgroup= moves the payload into
# a leaf so the unit cgroup is free to enable controllers.
#
# systemd 252+ (Debian 13 ships 257). On anything older this is an unknown key:
# systemd logs a warning and carries on, degrading to the EBUSY case rather
# than refusing to start the unit.
DelegateSubgroup=supervisor

# Environment
Environment=PATH={{ istota_home }}/.venv/bin:{{ istota_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME={{ istota_home }}
Environment=PYTHONUNBUFFERED=1
Environment=ISTOTA_ADMINS_FILE=/etc/{{ istota_namespace }}/admins
{% if istota_whisper_enabled | default(false) %}
Environment=WHISPER_MAX_MODEL={{ istota_whisper_max_model }}
{% endif %}
{% if istota_use_environment_file | default(false) %}
EnvironmentFile=/etc/{{ istota_namespace }}/secrets.env
{% endif %}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ istota_namespace }}-scheduler

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths={{ istota_home }}
ReadWritePaths=/var/log/{{ istota_namespace }}
{% if istota_use_nextcloud_mount %}
ReadWritePaths={{ istota_nextcloud_mount_path }}
{% endif %}

[Install]
WantedBy=multi-user.target
