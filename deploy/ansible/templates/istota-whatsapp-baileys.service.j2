[Unit]
Description={{ istota_namespace | capitalize }} WhatsApp Baileys sidecar
After=network.target
# Wants and After rather than Requires, and the difference is the whole of this
# unit's relationship with the daemon. The scheduler owns the listener, but the
# sidecar retries a missing socket every two seconds for ever — so it does not
# need the scheduler to be up, and a scheduler restart must not take the paired
# WhatsApp session down with it. Ordering it after merely saves a burst of
# reconnects on a cold boot.
After={{ istota_namespace }}-scheduler.service
Wants={{ istota_namespace }}-scheduler.service

[Service]
Type=simple
User={{ istota_user }}
Group={{ istota_group }}
WorkingDirectory={{ istota_repo_dir }}/docker/whatsapp-baileys
ExecStart={{ istota_whatsapp_baileys_node_bin }} {{ istota_repo_dir }}/docker/whatsapp-baileys/index.js

# Restart=always, including after the sidecar exits 1 on a logged-out session.
# That is the recovery path the program is written for: the session stays dead
# and every send is refused until somebody re-pairs, and when they do, this unit
# comes back and its `ready` frame clears the daemon's latch. The in-process
# supervisor deliberately does not respawn a permanent fatal, which is why the
# unit shape is the better one on this deployment.
#
# Thirty seconds rather than five, because of what the steady state of that
# recovery path is: a de-paired session is a start-log-exit cycle that runs
# until a person scans a code, and nobody does that inside five seconds. At
# five it writes twelve entries a minute into sidecar.log — inside the 0700
# credential directory, where `StandardOutput=null` means nothing else sees it
# — for however long the account stays unlinked. The same cycle covers a tree
# with no node_modules (exit 3). StartLimit is left off deliberately: entering
# `failed` would make a re-pair need a `systemctl start` as well as a scan.
Restart=always
RestartSec=30

# Both are required and the program exits 2 without either — the session
# directory is where its own log lives, so there is no channel left to complain
# on. The socket name has no config override at all, and session_dir is left
# unset in config.toml so it resolves to exactly this path; both are derived
# from db_path, which config.toml.j2 renders as {{ istota_home }}/data/istota.db.
Environment=ISTOTA_BAILEYS_SOCKET={{ istota_home }}/data/whatsapp-baileys.sock
Environment=ISTOTA_BAILEYS_SESSION_DIR={{ istota_home }}/data/whatsapp-baileys-session
Environment=ISTOTA_BAILEYS_LOG_LEVEL={{ istota_whatsapp_baileys_log_level }}
Environment=HOME={{ istota_home }}
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# The program writes nothing to stdout and nothing to stderr — Baileys' own
# logger is set silent and its diagnostics go to sidecar.log inside the 0700
# session directory, because a chatty WhatsApp client puts phone numbers and
# message bodies wherever it is pointed. stdout is discarded for that reason;
# stderr is kept, because what reaches it is not the program's own words but
# Node's — a module that would not load or an uncaught exception — and a unit
# that flaps with no message anywhere is the worse failure.
StandardOutput=null
StandardError=journal
SyslogIdentifier={{ istota_namespace }}-whatsapp-baileys

# Soft memory throttle, as on the web and webhook units and for the same
# reason: past the limit the kernel reclaims hard and slows this cgroup rather
# than killing it. This one is a long-lived Node process carrying a
# third-party dependency tree, on a host whose zram work exists because of
# memory pressure. An empty value omits the directive rather than emitting one
# systemd would reject.
{% if istota_whatsapp_baileys_memory_high %}
MemoryHigh={{ istota_whatsapp_baileys_memory_high }}
MemoryAccounting=yes
{% endif %}

# Security hardening. The directives are the webhook receiver's; the write path
# is **narrower than that unit's on purpose**. Those units run istota's own
# code, so `ReadWritePaths={{ istota_home }}` is a boundary around the
# deployment; this one runs `@whiskeysockets/baileys` and its transitive tree
# while holding a full WhatsApp account, and everything it writes — the session
# directory and its own log — is under {{ istota_home }}/data. Naming the parent
# would hand it the framework database, every module database and the checkout
# its own ExecStart reads from.
#
# UMask, because systemd's default is 0022 and Baileys writes the session files
# itself: every key file written after pairing landed 0644, which is a
# full-account WhatsApp credential readable by every account on the host. The
# program sets the same umask on itself, which is what reaches the compose
# shape — a compose service cannot express one — so this is defence in depth
# and the half an operator reading the unit can see.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths={{ istota_home }}/data

[Install]
WantedBy=multi-user.target
