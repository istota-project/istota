#!/bin/bash
# {{ istota_namespace | capitalize }} auto-update script - managed by Ansible
set -euo pipefail

REPO_DIR="{{ istota_repo_dir }}"
REPO_BRANCH="{{ istota_repo_branch }}"
REPO_TAG="{{ istota_repo_tag }}"
NAMESPACE="{{ istota_namespace }}"
PACKAGE="{{ istota_package }}"
USER="{{ istota_user }}"
GROUP="{{ istota_group }}"
HOME_DIR="{{ istota_home }}"
DB_PATH="{{ istota_home }}/data/istota.db"
LOG="/var/log/{{ istota_namespace }}/{{ istota_namespace }}-update.log"
LOCK="/tmp/{{ istota_namespace }}-update.lock"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

exec >> "$LOG" 2>&1

# Acquire exclusive lock (exit silently if another run is in progress)
exec 200>"$LOCK"
flock -n 200 || exit 0

cd "$REPO_DIR"

# Reap stale claude CLI builds. The CLI self-updates on its own schedule and
# leaves every previous version behind at ~320MB each; nothing else removes
# them. This runs before the "already up to date" early exits below, because
# claude's release cadence has nothing to do with this repo's — gating the
# prune on an istota update meant it never ran on a tag-pinned host.
#
# Keep the newest N by mtime and always spare the build the launcher points at:
# after a rollback the live build is deliberately not the newest file. The
# comparison is on the entry *name* rather than the full path, because
# `readlink -f` canonicalises every component while a concatenated path does
# not — the two only match when no parent directory is a symlink.
CLAUDE_VERSIONS_KEEP={{ istota_claude_versions_keep }}
CLAUDE_VERSIONS_DIR="${HOME_DIR}/.local/share/claude/versions"
# A non-numeric or empty override would make $((KEEP + 1)) evaluate to 1, i.e.
# "delete everything". Refuse the value rather than the directory.
if ! [ "$CLAUDE_VERSIONS_KEEP" -ge 1 ] 2>/dev/null; then
    log "WARNING: claude_versions_keep is not a positive integer, skipping prune"
elif [ -d "$CLAUDE_VERSIONS_DIR" ]; then
    CLAUDE_LIVE_NAME="$(basename "$(readlink -f "${HOME_DIR}/.local/bin/claude" 2>/dev/null || true)")"
    if [ -z "$CLAUDE_LIVE_NAME" ] || [ ! -e "${CLAUDE_VERSIONS_DIR}/${CLAUDE_LIVE_NAME}" ]; then
        # A guard that cannot name the live build must not delete anything.
        log "WARNING: cannot resolve the live claude build, skipping prune"
    else
        # Best-effort: this must not abort the run under set -e.
        ls -1t "$CLAUDE_VERSIONS_DIR" 2>/dev/null | tail -n +$((CLAUDE_VERSIONS_KEEP + 1)) | \
        while IFS= read -r stale_version; do
            [ -n "$stale_version" ] || continue
            [ "$stale_version" != "$CLAUDE_LIVE_NAME" ] || continue
            # rm -rf, not -f: a future layout where a version is a directory
            # would otherwise fail silently and reclaim nothing. $stale_version
            # comes from ls and cannot contain a slash.
            if rm -rf "${CLAUDE_VERSIONS_DIR}/${stale_version}"; then
                log "Removed stale claude version ${stale_version}"
            else
                log "WARNING: could not remove claude version ${stale_version}"
            fi
        done || true
    fi
fi


# ISSUE-258: the clone token now comes from a credential helper rather than
# from remote.origin.url, so a missing or revoked token makes git ask for a
# username instead of failing. There is no terminal here and stdin is not
# closed, so a prompt would hang this run forever while holding the flock —
# every later run would then exit silently at the lock and updates would stop
# with nothing reported. Fail fast instead and leave the reason in the log.
export GIT_TERMINAL_PROMPT=0

git fetch origin --tags --quiet

if [ -n "$REPO_TAG" ]; then
    # Tag mode: resolve latest semver tag and check if we need to update
    if [ "$REPO_TAG" = "latest" ]; then
        TARGET_TAG=$(git tag -l 'v*' --sort=-v:refname | head -1)
    else
        TARGET_TAG="$REPO_TAG"
    fi

    if [ -z "$TARGET_TAG" ]; then
        log "ERROR: No semver tags found in repository"
        exit 1
    fi

    CURRENT=$(git rev-parse HEAD)
    TARGET=$(git rev-parse "$TARGET_TAG^{}" 2>/dev/null || git rev-parse "$TARGET_TAG")

    if [ "$CURRENT" = "$TARGET" ]; then
        exit 0
    fi

    log "Updating to tag $TARGET_TAG ($CURRENT -> $TARGET)"
    git reset --hard "$TARGET_TAG" --quiet
else
    # Branch mode: check if remote has new commits
    CURRENT=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse "origin/$REPO_BRANCH")

    if [ "$CURRENT" = "$REMOTE" ]; then
        exit 0
    fi

    log "Updating branch $REPO_BRANCH ($CURRENT -> $REMOTE)"
    git reset --hard "origin/$REPO_BRANCH" --quiet
fi

# Fix repo ownership
chown -R "${USER}:${GROUP}" "$REPO_DIR"

# Install/update dependencies
log "Installing dependencies"
UV_ARGS="sync"
{% if istota_install_all_extras | default(true) %}
UV_ARGS="$UV_ARGS --extra all"
{% else %}
{% if istota_memory_search_enabled %}
UV_ARGS="$UV_ARGS --extra memory-search"
{% endif %}
{% if istota_whisper_enabled %}
UV_ARGS="$UV_ARGS --extra whisper"
{% endif %}
{% if istota_location_enabled | default(false) %}
UV_ARGS="$UV_ARGS --extra location"
{% endif %}
{% endif %}
PATH="/root/.local/bin:$PATH" uv $UV_ARGS

# Fix venv ownership
chown -R "${USER}:${GROUP}" "${REPO_DIR}/.venv"

# Run DB migrations
log "Running database migrations"
"${HOME_DIR}/.venv/bin/python" -c "from pathlib import Path; import sys; sys.path.insert(0, 'src'); from ${PACKAGE}.db import init_db; init_db(Path('${DB_PATH}'))"
sqlite3 "$DB_PATH" "ALTER TABLE processed_emails ADD COLUMN \"references\" TEXT;" 2>/dev/null || true
sqlite3 "$DB_PATH" "ALTER TABLE tasks ADD COLUMN output_target TEXT;" 2>/dev/null || true
sqlite3 "$DB_PATH" "ALTER TABLE scheduled_jobs ADD COLUMN output_target TEXT;" 2>/dev/null || true

# Fix DB ownership
chown "${USER}:${GROUP}" "$DB_PATH"

# Restart services. All long-running Python services hold the old code in
# memory until restarted — restarting only the scheduler left the web UI and
# webhook receiver serving stale code after every auto-update. Gated on the
# same flags as the Ansible restart handlers.
log "Restarting ${NAMESPACE}-scheduler"
systemctl restart "${NAMESPACE}-scheduler"
{% if istota_web_enabled | default(false) %}
log "Restarting ${NAMESPACE}-web"
systemctl restart "${NAMESPACE}-web"
{% endif %}
{% if istota_location_enabled | default(false) %}
log "Restarting ${NAMESPACE}-webhooks"
systemctl restart "${NAMESPACE}-webhooks"
{% endif %}
{% if istota_devbox_enabled and not istota_web_only and (istota_devbox_users | length > 0) %}
# The two per-user proxies import from the checkout as well, and they are the
# security boundary: docker-proxy is the allowlist in front of a
# root-equivalent Docker socket, devbox-proxy holds the credentials. Left out
# of this list they kept serving the pre-update module indefinitely, which is
# how the ISSUE-294 keep-alive bypass stayed live after its fix merged.
{% for devbox_user in istota_devbox_users %}
{% if istota_devbox_proxy_enabled %}
log "Restarting ${NAMESPACE}-devbox-proxy@{{ devbox_user }}"
systemctl restart "${NAMESPACE}-devbox-proxy@{{ devbox_user }}"
{% endif %}
{% if istota_devbox_api_proxy_enabled %}
log "Restarting ${NAMESPACE}-docker-proxy@{{ devbox_user }}"
systemctl restart "${NAMESPACE}-docker-proxy@{{ devbox_user }}"
{% endif %}
{% endfor %}
{% endif %}

log "Update complete"
