#!/bin/sh
# {{ istota_namespace | capitalize }} clone-token credential helper — managed by Ansible.
#
# ISSUE-258. git asks this for the clone token instead of reading it out of
# remote.origin.url, so the token never enters the checkout or an argument
# vector. It answers `get` and ignores every other verb, which is the whole
# reason it exists rather than git's built-in `store` helper:
#
#   - `store` implements `erase`, and git calls `erase` on any 401. One
#     expired, revoked or freshly-rotated token would empty the credential
#     file, and the auto-update fetch — every two minutes, MAILTO="", output
#     redirected to a log — would then fail silently until someone re-ran
#     Ansible. A helper that cannot forget cannot fail that way.
#   - `store` also rewrites its file on a successful auth, which lets an
#     unrelated root git operation against the same host swap the deploy
#     credential, and makes Ansible's copy of that file non-idempotent.
#
# Reading the token from a file rather than embedding it here keeps the secret
# in one 0600 place, so rotating it is a single file write.
set -eu

[ "${1:-}" = "get" ] || exit 0

# Fall through quietly rather than answering with an empty password: a caller
# that cannot read the token file (anyone but root) should look like "no
# credential configured", not like a wrong one.
token=$(cat /etc/{{ istota_namespace }}/clone-token 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0

printf 'username=oauth2\n'
printf 'password=%s\n' "$token"
