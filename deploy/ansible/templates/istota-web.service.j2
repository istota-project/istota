[Unit]
Description={{ istota_namespace | capitalize }} Web Interface
After=network.target
{% if istota_use_nextcloud_mount %}
After=mount-nextcloud.service
# Requires (not Wants): the web app reads/writes per-user DBs on the rclone
# mount. Don't start until the FUSE mount is actually live, and stay down if it
# fails, so we never read empty re-inits or seed the bare mountpoint.
Requires=mount-nextcloud.service
{% endif %}

[Service]
Type=simple
User={{ istota_user }}
Group={{ istota_group }}
WorkingDirectory={{ istota_repo_dir }}
# --timeout-graceful-shutdown: the web-chat room stream (GET /chat/stream) is a
# session-lived SSE response that never completes on its own — it exits only on
# client disconnect, which server shutdown does not trigger. Without a deadline
# uvicorn waits forever for it ("Waiting for connections to close"), so every
# restart with a browser tab open sat out the full TimeoutStopSec and died on
# SIGKILL. The flag makes uvicorn cancel the stragglers instead.
ExecStart={{ istota_home }}/.venv/bin/uvicorn {{ istota_package }}.web_app:app --host 127.0.0.1 --port {{ istota_web_port }} --timeout-graceful-shutdown {{ istota_web_graceful_shutdown_seconds }}
Restart=always
RestartSec=5

# Belt-and-braces cap on the stop phase. uvicorn should be gone in about
# {{ istota_web_graceful_shutdown_seconds }}s, so a SIGKILL at this deadline means it wedged rather than
# that it is still draining. Well under systemd's 90s default.
TimeoutStopSec={{ istota_web_stop_timeout_seconds }}

# FD ceiling — see scheduler unit. Web reads framework istota.db plus
# per-user feeds.db / location.db on every request.
LimitNOFILE=65536

# Environment
Environment=PATH={{ istota_home }}/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME={{ istota_home }}
Environment=PYTHONUNBUFFERED=1
Environment=ISTOTA_ADMINS_FILE=/etc/{{ istota_namespace }}/admins
{% if istota_use_environment_file | default(false) %}
EnvironmentFile=/etc/{{ istota_namespace }}/secrets.env
{% endif %}
{% if istota_web_token_key | default('') | length > 0 %}
# Web-only: the user-token key never enters the scheduler/webhooks units.
EnvironmentFile=/etc/{{ istota_namespace }}/web-secrets.env
{% endif %}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ istota_namespace }}-web

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths={{ istota_home }}
{% if istota_use_nextcloud_mount %}
ReadWritePaths={{ istota_nextcloud_mount_path }}
{% endif %}

[Install]
WantedBy=multi-user.target
