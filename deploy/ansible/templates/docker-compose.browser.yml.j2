services:
  browser:
    build:
      context: {{ istota_repo_dir }}/docker/browser/
      dockerfile: Dockerfile
    container_name: {{ istota_namespace }}-browser
    # PID 1 in this image is `su` (entrypoint.sh ends with `exec su … python`),
    # which reaps no orphan. Chrome's renderer, GPU, zygote and crashpad
    # processes are children of the browser process, so every hard kill of it
    # reparents them here -- 43 zombies in 40 minutes of production before
    # ISSUE-394. The API now kills Chrome's whole process group and waits on it;
    # this is the backstop for whatever still escapes.
    init: true
    ports:
      - "127.0.0.1:{{ istota_browser_api_port }}:9223"
      # Compose requires an IPv6 host address to be bracketed, so a bare `::1`
      # would render "::1:6080:6080" and fail to parse. Bracketed here rather
      # than demanded of the operator: the guard in tasks/main.yml accepts both
      # spellings, and a value the guard blesses has to be one this can render.
      - "{{ ('[' ~ istota_browser_vnc_bind_address ~ ']') if (':' in istota_browser_vnc_bind_address and not istota_browser_vnc_bind_address.startswith('[')) else istota_browser_vnc_bind_address }}:{{ istota_browser_vnc_port }}:6080"
    shm_size: {{ istota_browser_shm_size }}
    volumes:
      - {{ istota_home }}/data/browser-profile:/data/browser-profile
    env_file:
      - {{ istota_home }}/browser.env
    deploy:
      resources:
        limits:
          cpus: "{{ istota_browser_cpu_limit }}"
          memory: {{ istota_browser_memory_limit }}
    restart: unless-stopped
