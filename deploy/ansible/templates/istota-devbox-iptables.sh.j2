#!/bin/bash
# Re-apply the devbox DOCKER-USER DROP rules at boot.
#
# Why this exists: Docker manages POSTROUTING MASQUERADE and DOCKER-FORWARD
# rules dynamically at network-create / daemon-start time. We previously
# tried to persist firewall state with iptables-persistent, but its
# snapshot-the-whole-table model fought Docker's runtime programming and
# silently lost the devbox bridge's outbound NAT rules on reboot. Instead,
# we let Docker own its own chains, and use this small oneshot to ensure
# our user-defined DROP rules in DOCKER-USER (which Docker preserves
# across daemon restarts) are present after every boot.
#
# Ordering: the istota-devbox-iptables.service unit specifies
# After=docker.service, so the DOCKER-USER chain exists by the time this
# runs.
#
# Position: `-I DOCKER-USER 1`, never `-A`. A user-defined chain stops
# evaluating at its first terminal rule, and a stock dockerd before v28
# populates DOCKER-USER with `-j RETURN` — so an appended rule is present
# in `iptables -S` and never evaluated, which is a boundary that looks
# identical to a working one (ISSUE-295). The Docker version is not the
# property to rely on either: Docker has never promised the chain is
# empty, Docker Desktop seeds it with `-i eth0 -j ACCEPT`, and ufw-docker
# inserts at the front.
#
# Convergence, not idempotence-by-guard: each rule is deleted wherever it
# currently sits and re-inserted at position 1, so running this on a host
# whose rules were appended by an older version of the role repairs them.
# The script therefore ends with exactly one copy of each rule at the head
# of the chain no matter what state it started in. The four rules end up
# in reverse call order, which does not matter: they are all DROP over
# disjoint destinations.

set -euo pipefail

SUBNET="{{ istota_devbox_network_subnet }}"

ensure_drop() {
    local dest="$1"
    local comment="$2"
    # Delete every existing copy, then insert at the front. Not a presence
    # guard: `-C` matches on the rule spec and is blind to position, so a
    # guard can only answer "is this rule somewhere in the chain" — which is
    # true of exactly the broken hosts this needs to repair, where the four
    # rules sit behind dockerd's `-j RETURN`. A guarded add therefore reports
    # success and moves nothing (ISSUE-295).
    #
    # The loop rather than a single `-D` because `-D` removes one match at a
    # time, and a chain that accumulated duplicates under the old unguarded
    # path would keep the copies behind the RETURN.
    while iptables -C DOCKER-USER -s "$SUBNET" -d "$dest" \
            -m comment --comment "$comment" -j DROP 2>/dev/null; do
        iptables -D DOCKER-USER -s "$SUBNET" -d "$dest" \
            -m comment --comment "$comment" -j DROP
    done
    iptables -I DOCKER-USER 1 -s "$SUBNET" -d "$dest" \
        -m comment --comment "$comment" -j DROP
}

retire_drop() {
    local dest="$1"
    local comment="$2"
    # A destination this role used to block and no longer does. `ensure_drop`
    # cannot converge one of these: it deletes by the rule's *current* spec,
    # which never matches the old rule, so without this the old rule survives
    # every run — and every teardown, since those name only the current set.
    #
    # Listed explicitly rather than derived. Deriving "ours but no longer
    # wanted" means parsing `iptables -S` output back into a delete, and the
    # field it would have to parse is an operator-supplied comment string.
    #
    # Runs regardless of the block_* flags: a host that has turned metadata
    # blocking off should still lose the rule this role no longer installs.
    while iptables -C DOCKER-USER -s "$SUBNET" -d "$dest" \
            -m comment --comment "$comment" -j DROP 2>/dev/null; do
        iptables -D DOCKER-USER -s "$SUBNET" -d "$dest" \
            -m comment --comment "$comment" -j DROP
    done
}

# Superseded by the whole-link-local rule below (ISSUE-298).
retire_drop "169.254.169.254/32" "istota-devbox: block cloud metadata"

{% if istota_devbox_block_metadata | default(true) %}
# The whole link-local /16 rather than the single metadata address. AWS serves
# instance DNS at 169.254.169.253, ECS task credentials — which hand out role
# credentials — at 169.254.170.2, and NTP at 169.254.169.123. There is nothing
# in that range a devbox legitimately needs.
ensure_drop "169.254.0.0/16" "istota-devbox: block link-local (incl. cloud metadata)"
# Azure's WireServer / host agent. Neither link-local nor RFC1918, so without
# this the metadata block is half applied on an Azure host.
ensure_drop "168.63.129.16/32" "istota-devbox: block Azure host agent"
{% endif %}
{% if istota_devbox_block_rfc1918 | default(true) %}
ensure_drop "10.0.0.0/8" "istota-devbox: block 10.0.0.0/8"
ensure_drop "172.16.0.0/12" "istota-devbox: block 172.16.0.0/12"
ensure_drop "192.168.0.0/16" "istota-devbox: block 192.168.0.0/16"
# RFC 6598 carrier-grade NAT, and the range Tailscale hands out. ip_forward is
# on and the MASQUERADE rule is `! -o br-devbox`, so on a host that joins a
# tailnet the devbox would masquerade straight into it — the pivot these rules
# exist to stop, arriving over a range none of the others name.
ensure_drop "100.64.0.0/10" "istota-devbox: block 100.64.0.0/10"
{% endif %}
