{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app",
  "description": "The app's own window and its bundled pages. No web UI window is listed: those hold no Tauri webview at all (src/web.rs).",
  "windows": ["app"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-status",
    "allow-open-web",
    "allow-open-setup",
    "allow-vm-start",
    "allow-show-log-files",
    "allow-quit-app",
    "allow-first-run-info",
    "allow-pick-folder",
    "allow-begin-setup",
    "allow-resume-setup",
    "allow-cancel-setup",
    "allow-settings-info",
    "allow-retry-layers",
    "allow-set-claude-code",
    "allow-set-host-port",
    "allow-restore-backup",
    "allow-remove-istota",
    "allow-locate-folder",
    "allow-profiles-info",
    "allow-add-profile",
    "allow-select-profile",
    "allow-remove-profile",
    "allow-cli-tools-info",
    "allow-install-cli-tools",
    "allow-remove-cli-tools"
  ]
}
