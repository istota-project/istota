{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Istota",
  "version": "0.0.1",
  "identifier": "org.istota.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["app"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "The Istota authors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": {
      "../../host/mac/istota-stack": "bin/istota-stack",
      "../../host/mac/istota": "bin/istota",
      "../../host/lima/istota.yaml": "lima/istota.yaml"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements/app.plist",
      "hardenedRuntime": true
    }
  }
}
