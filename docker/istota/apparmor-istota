# The AppArmor profile for the istota container: Docker's own docker-default
# (moby/profiles at engine 29.9.0, rendered beside this file as
# apparmor-docker-default-29.9.0) with the rules bubblewrap and the root
# phase's cgroup remount need, and nothing else changed.
#
# docker-default carries `deny mount,`. Under it bwrap fails at its first
# mount ("Failed to make / slave") and the cgroup remount fails with EACCES, on
# any host where AppArmor is enabled, Debian 13 included. Changes:
#
#   - `mount,` in place of `deny mount,`, and `pivot_root,`
#   - /proc/sys/user/max_user_namespaces writable, the one sysctl bwrap writes
#     (`--disable-userns`, inside the sandbox's own user namespace). Every other
#     /proc/sys write docker-default refuses stays refused, so a uid-0
#     `docker exec` still cannot write kernel/core_pattern or sysrq-trigger.
#
# No `userns,` rule: the profile keeps docker-default's `abi <abi/3.0>`, under
# which user namespace creation is not mediated (measured on Debian 13; the
# Stage 1 draft needed the rule only because it had no abi line). Raising the
# abi would need it back.
#
# Loaded on the VM by provision.sh (`apparmor_parser -r -W`) before the stack
# starts, and named in compose as `apparmor=istota`. A host without AppArmor
# ignores the option. tests/test_container_security_profiles.py holds the
# difference from docker-default to exactly the list above.

abi <abi/3.0>,

#include <tunables/global>

profile "istota" flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  # Disallow AF_ALG (Linux kernel crypto API); see https://copy.fail/
  deny network alg,
  # Disallow AF_VSOCK to prevent host/guest communication.
  deny network vsock,
  capability,
  file,
  umount,
  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer="unconfined",
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer="istota",

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^ku]** w,  # deny /proc/sys except /proc/sys/k* and /proc/sys/u*
  deny @{PROC}/sys/u[^s]** w,
  deny @{PROC}/sys/user/[^m]** w,
  deny @{PROC}/sys/user/max_[^u]** w,
  deny @{PROC}/sys/user/max_u[^s]** w,  # leaves max_user_namespaces alone writable
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  mount,
  pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # allow processes within the container to trace each other,
  # provided all other LSM and yama setting allow it.
  ptrace (trace,tracedby,read,readby) peer="istota",
}
