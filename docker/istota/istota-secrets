#!/bin/bash
# Export every credential compose mounts under /run/secrets into the
# environment, under its file name uppercased, then exec "$@".
#
# `istota setup` writes one file per credential, named for the variable the
# daemon reads it from (istota_nextcloud_app_password becomes
# ISTOTA_NEXTCLOUD_APP_PASSWORD), so a value never appears in compose's
# `environment:` or in `docker inspect`. An empty file is a credential the
# install does not use and exports nothing.
#
# Runs after the drop, as uid 10001, which is the files' owner: the root phase
# holds no CAP_DAC_OVERRIDE and could not read a 0400 file owned by 10001
# anyway. `istota-drop` execs this, so every exec path that drops (the daemon,
# web, webhooks, an operator's CLI call) sees the same credentials.
set -euo pipefail

dir="${ISTOTA_SECRETS_DIR:-/run/secrets}"
if [ -d "$dir" ]; then
    for path in "$dir"/*; do
        [ -f "$path" ] || continue
        name="${path##*/}"
        case "$name" in
            [a-z]*) ;;
            *) continue ;;
        esac
        case "$name" in
            *[!a-z0-9_]*) continue ;;
        esac
        if [ ! -r "$path" ]; then
            echo "[istota-secrets] REFUSE: ${dir}/${name} is not readable by uid $(id -u)." >&2
            echo "[istota-secrets] REFUSE: on the VM, chown 10001:10001 and chmod 0400 the file." >&2
            exit 78
        fi
        value="$(cat "$path")"
        [ -n "$value" ] || continue
        # `tr` rather than ${name^^}, which bash 3.2 (macOS, where the tests
        # also run this) does not have.
        export "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')=${value}"
    done
fi
exec "$@"
