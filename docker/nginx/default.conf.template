# Reverse proxy in front of Nextcloud + the istota web UI.
#
# Substituted at container start by the nginx:alpine entrypoint:
#   ${DOMAIN}                       — server_name (e.g. localhost or example.com)
#   ${WEB_PORT}                     — istota web service port (internal)
#   ${NGINX_CLIENT_MAX_BODY_SIZE}   — upload cap (Nextcloud needs ~512M+)
#
# Nginx runtime variables (anything else with $) pass through unchanged because
# NGINX_ENVSUBST_FILTER is set in docker-compose.yml.
#
# TLS is opt-in. Drop a cert and key under ./nginx/certs/ on the host, replace
# the listen 80 block below with a 443 block, and uncomment the corresponding
# port mapping on the nginx service in docker-compose.yml.

# Connection-upgrade map for websocket-style requests (Talk long-poll, NC
# notifier). Lives at http level — included via /etc/nginx/conf.d/.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    server_name ${DOMAIN};

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # Long-poll friendliness for Nextcloud Talk + the istota web UI.
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # Re-resolve service names via Docker's embedded DNS on every request
    # window, not at config-load. Without this, nginx caches the IP for `web`
    # and `nextcloud` once at startup; recreating either container (image
    # upgrade, `docker compose restart web`) gives it a new IP and nginx keeps
    # 502'ing forever until nginx itself is restarted. `valid=30s` bounds the
    # cache; `ipv6=off` avoids spurious AAAA lookups inside Docker bridges.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $upstream_web      web:${WEB_PORT};
    set $upstream_nextcloud nextcloud:80;
    set $upstream_signaling signaling:8080;

    # Every location below forwards `Host: $http_host`, not `$host`. The two
    # differ in exactly one way that matters here: `$host` is normalized with
    # the **port stripped**, so a stack published on anything but :80 hands the
    # upstream `localhost` and every absolute URL that upstream builds from the
    # Host header loses the port. The visible case is the SPA's own directory
    # redirect — Starlette answers `/istota/chat` with a 307 to
    # `{scheme}://{Host header}/istota/chat/`, so on a stack at :8282 a direct
    # navigation lands on `http://localhost/istota/chat/`, which is nothing.
    # Clicking through the app never hits it, which is why this survived.
    #
    # `$http_host` is the client's header verbatim. It is empty only for an
    # HTTP/1.0 request that sent no Host at all — HTTP/1.1 requires one and
    # nginx answers 400 without it — and nginx omits a header whose value is
    # empty, which is the HTTP/1.0-correct outcome anyway.

    # Task event SSE stream — must stream, not buffer. Longest-prefix match wins
    # over /istota/. The web app also sets `X-Accel-Buffering: no`; this block
    # turns buffering off explicitly and lifts the read timeout so a long idle
    # gap between events doesn't drop the stream.
    location /istota/api/chat/ {
        proxy_pass http://$upstream_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Istota web UI. Must come before / so /istota/ doesn't fall through to NC.
    # SvelteKit static build is served under base /istota — preserve the URI
    # by giving proxy_pass no path component.
    location /istota/ {
        proxy_pass http://$upstream_web;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Nextcloud Talk's standalone signaling server (the "high-performance
    # backend"), which runs behind the `signaling` compose profile. It is
    # proxied here because Talk stores exactly one URL for it and two different
    # clients use that URL: a browser, and Nextcloud's own PHP from inside the
    # `nextcloud` container. The server's own published port satisfies neither
    # pair — it is a host-side publish, and from PHP `localhost` is Nextcloud's
    # own loopback — so the address that works for both is a path on the front
    # end that already serves Nextcloud.
    #
    # `$upstream_signaling` is a variable so the name is resolved per request.
    # With the profile off there is no `signaling` container at all, and a
    # literal upstream would fail config load and take the front end for the
    # whole stack down with it. `rewrite ... break` strips the prefix, which
    # proxy_pass cannot do once its upstream is a variable.
    #
    # Buffering off and a long read timeout because `/spreed` is a websocket
    # that stays open for the life of a client's session.
    location /standalone-signaling/ {
        rewrite ^/standalone-signaling/(.*)$ /$1 break;
        proxy_pass http://$upstream_signaling;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # WebDAV / sync endpoints — disable buffering so large file uploads stream
    # straight through to Apache instead of buffering on the nginx side.
    location ~ ^/(remote\.php/(dav|webdav)|public\.php/dav) {
        proxy_pass http://$upstream_nextcloud;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size 0;
    }

    # Nextcloud — everything else. Keep nginx's default buffering on so HTML/
    # JSON responses still benefit from gzip and chunk coalescing. The image
    # is nextcloud:apache, so PHP routing / .htaccess immunity is handled
    # behind the upstream.
    location / {
        proxy_pass http://$upstream_nextcloud;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
