# =============================================================================
# Istota Docker Compose: stack-level settings
#
# This file configures the compose stack, never istota itself. istota's
# configuration is /data/config/config.toml on the state volume, written once by
#
#     docker compose run --rm --entrypoint istota-drop istota istota setup --vm-dir /vm
#
# (with this directory bound at /vm), and owned by you after that. The same run
# writes this file as .env, and one file per credential under secrets/, which
# compose mounts at /run/secrets. No credential belongs in this file.
#
# Optional services (Docker Compose profiles), listed in COMPOSE_PROFILES:
#   browser           Chrome container the `browse` skill drives
#   location          GPS webhook receiver for the Overland app
#   sms               SMS webhook receiver for Twilio or Telnyx
#   whatsapp          WhatsApp webhook receiver for Meta's Cloud API
#   whatsapp-baileys  WhatsApp Node sidecar for a paired WhatsApp Web session
#   signaling         Talk standalone signaling server
# =============================================================================

# Pinned so the project does not take the directory's name, which would merge
# a second clone under another path into this stack.
COMPOSE_PROJECT_NAME=istota

# Comma-separated, no spaces. Empty starts the core stack only.
COMPOSE_PROFILES=

# Where the credential files are. Relative to this directory.
ISTOTA_SECRETS_DIR=./secrets

# The public hostname browsers use (nginx server_name).
DOMAIN=

# What nginx publishes: the plain-HTTP slot and the TLS slot, as compose port
# specs. `istota setup --vm-dir` writes both for the ingress mode in vm.env;
# a slot the mode does not use is an ephemeral loopback port.
NGINX_PUBLISH=127.0.0.1:8080:80
NGINX_PUBLISH_TLS=127.0.0.1::443

# 1 for plain http on loopback, where a Secure cookie is never sent back; 0
# behind TLS.
ISTOTA_WEB_INSECURE_COOKIES=1

# --- Browser profile ---------------------------------------------------------
# BROWSER_PLATFORM=linux/amd64
# BROWSER_API_BIND=127.0.0.1
# BROWSER_API_PORT=9223
# BROWSER_VNC_BIND=127.0.0.1
# BROWSER_VNC_PORT=6080
# BROWSER_SHM_SIZE=2gb
# BROWSER_MEMORY_LIMIT=3G
# VNC_PASSWORD=

# --- Signaling profile -------------------------------------------------------
# Talk's own credential for the signaling server, which you register with your
# Nextcloud's Talk (`occ talk:signaling:add`), and your Nextcloud's URL(s) for
# the server to accept. Left empty, the secret is random per container.
# ISTOTA_TALK_SIGNALING_SECRET=
# ISTOTA_TALK_SIGNALING_BACKEND_URLS=https://cloud.example.com
