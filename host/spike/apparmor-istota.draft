# Stage 1 spike: Docker's docker-default AppArmor profile (moby
# profiles/apparmor/template.go) with the one change bwrap and the root
# phase's cgroup remount need. docker-default carries `deny mount,`, which
# refuses bwrap's first mount ("Failed to make / slave") and the remount
# (EACCES) on any VM where AppArmor is enabled, Debian 13 included.
#
# Changes from docker-default, and nothing else:
#   - `mount,` and `pivot_root,` allowed instead of `deny mount,`
#   - `userns,` allowed
#   - /proc/sys/user/max_user_namespaces writable: bwrap --disable-userns
#     writes it inside the sandbox's own user namespace
#
# Loaded on the VM with `apparmor_parser -r -W <this file>`; referenced from
# compose as `apparmor=istota-spike-default`. Not shipped.

#include <tunables/global>

profile istota-spike-default flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  # A profile compiled against the VM's own feature ABI mediates user
  # namespace creation; without this bwrap fails "Creating new namespace
  # failed: Permission denied" (measured).
  userns,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=istota-spike-default,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^ku]** w,  # deny /proc/sys except /proc/sys/k* and /proc/sys/u*
  deny @{PROC}/sys/u[^s]** w,
  deny @{PROC}/sys/user/[^m]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=istota-spike-default,
}
