#!/bin/bash
# istota-stack: the VM's command for the one istota stack on it. Run as root.
#
#   istota-stack update         the newest signed release (vX.Y.Z), verified, built and
#                               switched to; nothing when the stack already runs it
#   istota-stack update <tag>   verify a signed release tag, build it, switch to it
#   istota-stack update --unsigned <tag>
#                               the same for any tag, signed or not, on request
#   istota-stack update --unsigned latest
#                               the tip of main, recorded as main-<commit>
#   istota-stack update <tag> --bundle FILE
#                               the same signed release, its tag taken from a git bundle
#                               (the Mac app's release) rather than fetched from origin
#   istota-stack update <tag> --images DIR [--bundle FILE]
#                               the same signed release, its images loaded from DIR's
#                               images-<tag>.tar under a manifest the release key signed,
#                               rather than built
#   istota-stack local-layers   build what a release's images leave out because it may not
#                               be redistributed, as host.env's ISTOTA_LOCAL_LAYERS names
#                               (both when unset): Claude Code as istota:<tag>-cc, which
#                               the stack then runs, and Chrome as istota-browser:<tag>
#   istota-stack local-layers --status
#                               one JSON line per layer: absent, building, ready or failed
#   istota-stack trust-signer KEY
#                               print the fingerprint of KEY, one line of an SSH public
#                               key, and make it the one key releases are verified against
#   istota-stack latest-tag     print the name update --unsigned latest would install; changes nothing
#   istota-stack rollback       back to the previous tag, if its image can run the database;
#                               reprovisions the host as update does
#   istota-stack setup [args]   run `istota setup` for this VM (first install, or --force;
#                               --desktop-app makes a local install moved into the Mac
#                               app the app's: its login codes and settings)
#   istota-stack setup --web [--local]
#                               the first setup in a browser: prints an address and a
#                               one-use code, then installs, builds and starts the stack
#   istota-stack setup --web --force [--local]
#                               change the setup in a browser: the stack is stopped for
#                               the run, and put back as it was if the run does not finish
#   istota-stack setup-code     print the address and code of a setup --web in progress
#   istota-stack setup-cancel   end a setup --web in progress
#   istota-stack apply <plan> [--secrets-file FILE] [--no-restart] [istota apply's options]
#                               `istota apply` a plan; prints its JSON result, and restarts
#                               the stack once when a committed change needs it, this
#                               apply's or one an earlier `--no-restart` apply left owed
#   istota-stack import-bare-metal <dir> [args]
#                               import a bare-metal export, with the stack down
#   istota-stack restore [--date YYYY-MM-DD] [--force]
#                               the master key (on stdin), the config and the databases
#                               from the workspace's backups, onto a stack never set up
#   istota-stack import-standalone <dir> --hostname HOST [--dry-run]
#                               a standalone install the Mac staged in <dir>, its istota.env
#                               on stdin, onto a stack never set up
#   istota-stack retire-bare-metal --namespace NS [--dry-run]
#                               remove what the old Ansible role installed, once the stack runs
#   istota-stack localize-workspace [--copy-only] [--resume] [--dry-run] [--no-note] [--accept-skipped]
#                               move a mounted workspace into the state directory, offline
#   istota-stack put-files [--dry-run]
#                               write secrets/ and config/admins from JSON on stdin, as uid 10001
#   istota-stack config-apply   apply what the web config editor requested (istota-config-apply.service)
#   istota-stack check-image    exit 2 when the image lacks what config.toml needs (Claude Code)
#   istota-stack up | down      start or stop the stack (istota-stack.service)
#   istota-stack exec <cmd...>  run a command in the daemon container as uid 10001
#   istota-stack compose <...>  docker compose, with this stack's files and settings
#   istota-stack host-env KEY | KEY=VALUE...
#                               print one host.env value, or set some, keeping every other line
#   istota-stack stage [--daemon] <path>
#                               move a file or directory into a fresh root-only directory
#                               under staging/ and print its new path (--daemon: uid 10001's)
#   istota-stack unstage <path> remove what `stage` made
#
# --- end usage ---
#
# The layout is /srv/app/istota (ISTOTA_STACK_DIR overrides it, for the tests):
#
#   src/              a git checkout of the repository, at the deployed tag
#   allowed_signers   the release key, written by provision.sh from host.env
#   .env              compose settings: the wizard's keys, ISTOTA_TAG, ISTOTA_PREVIOUS_TAG,
#                     and ISTOTA_TAG_UNSIGNED / ISTOTA_PREVIOUS_TAG_UNSIGNED for a tag
#                     installed with --unsigned
#   host.env          host settings, read by provision.sh and the units
#   config/           bound at /data/config, read-only to every running service
#   compose.devbox.yml   the devbox services, rendered by `istota devbox compose-file`
#   secrets/          one file per credential, 0400, owned by uid 10001
#   requests/         the web config editor's trigger, uid 10001's, bound into web alone
#   .stack.lock       held by every verb that writes; names the verb holding it
#   certs/ letsencrypt/ acme/   nginx's certificate sources and the ACME webroot
#
# The workspace mount is outside it: in full Nextcloud integration the rclone
# mount at /srv/mount/nextcloud/content, the path the bare-metal installs use
# (mount-nextcloud.service names it too); on the local VM the Mac folder Lima
# shares in at /srv/mount/host-folder. host.env's STORAGE picks which, and
# ISTOTA_MOUNT_DIR overrides it for the tests.
#
# The compose file is the checkout's own (src/docker/docker-compose.yml), so the
# compose file, the seccomp and AppArmor profiles and the images always come
# from the same verified tag. Paths that belong to this VM are passed to compose
# in the environment, which outranks .env.
#
# Release trust is a signed git tag, checked with `git verify-tag` against
# allowed_signers alone: git's global and system configuration are not read,
# OpenPGP and X.509 verification are switched off, and the tag object has to
# carry an SSH signature and name itself. A branch, a lightweight tag, an
# unsigned tag and a tag signed by any other key are refused before anything
# moves. tests/test_istota_stack.py holds each refusal.
#
# Only releases are signed. `update --unsigned <tag>` deploys any tag without a
# signature check, for that run; a branch is still refused, since rollback needs
# a name that stays put. .env marks the tag, and rollback returns to a marked tag
# without verifying it, because the operator accepted it when installing it.
#
# `update --unsigned latest` is the one way to follow main: it deploys the tip
# of origin's main and records it as main-<first 12 hex of the commit>, which
# names that commit for good, so rollback and the image tags work as for a tag.
# A main-<hex> name resolves only to a commit of main, never to any commit.
#
# `update <tag> --bundle FILE` changes only where the tag comes from: the one
# tag is fetched out of the bundle, never over an existing tag of that name,
# and verified as any release is. It refuses --unsigned. `trust-signer` is the
# one way the release key changes, and no update writes allowed_signers.
#
# `update <tag> --images DIR` changes only where the images come from. After the
# tag is verified, DIR's images-<tag>.json must carry a good SSH signature in the
# istota-images namespace against the same allowed_signers, name the tag and the
# archive's SHA-256, and every image `docker load` reports must be one it names,
# at the ID it names. A refusal after the load puts back what the load replaced.
# Nothing is built. It refuses --unsigned. Once the stack is up it runs
# `local-layers`, which builds on those images what no release may carry:
# Claude Code (istota:<tag>-cc, named by .env's ISTOTA_IMAGE) and Google Chrome
# (istota-browser:<tag>, FROM the archive's istota-browser-base:<tag>). A layer
# that fails leaves the stack on the release's own image. A server's update
# builds both into the full images and never runs it.
set -euo pipefail
# A hardened host (umask 027) would check the tree out root-only, and the
# image builds copy those modes in, out of uid 10001's reach.
umask 022

STACK="${ISTOTA_STACK_DIR:-/srv/app/istota}"
SRC="${STACK}/src"
ALLOWED_SIGNERS="${STACK}/allowed_signers"
ENV_FILE="${STACK}/.env"
HOST_ENV="${STACK}/host.env"
CONFIG_DIR="${STACK}/config"
SECRETS_DIR="${STACK}/secrets"
# The state bound at /data.
DATA_DIR="${STACK}/data"
# Search for others and nothing more: the container's root phase holds no DAC
# capability and must pass through to the volumes mounted below /data.
DATA_MODE=0711
# Beside .env, not in config/: root passes it to `docker compose`, and config/
# is uid 10001's to write.
DEVBOX_COMPOSE="${STACK}/compose.devbox.yml"
# A restart `apply --no-restart` left to the next apply; root's, beside .env.
RESTART_OWED="${STACK}/.restart-owed"
# `setup --web`'s own files: the code, the certificate and the instructions,
# root's alone, so everything it prints comes from a file uid 10001 cannot write.
SETUP_DIR="${STACK}/.setup"
LEGACY_DEVBOX_COMPOSE="${CONFIG_DIR}/compose.devbox.yml"
# Where the Mac CLI's file arguments (`apply <plan>`, `import-bare-metal <dir>`)
# are handed over: one fresh directory per call, removed after it.
STAGING_DIR="${STACK}/staging"
ISTOTA_UID=10001
PROJECT=istota
# The daemon, web and webhooks image. Releases before the service was renamed
# to `daemon` built it as istota-istota.
IMAGE=istota
LEGACY_IMAGE=istota-istota
# Overridable so tests/test_istota_stack.py can stand in for a host with AppArmor.
APPARMOR_SYSFS="${ISTOTA_APPARMOR_SYSFS:-/sys/kernel/security/apparmor}"
APPARMOR_DIR="${ISTOTA_APPARMOR_DIR:-/etc/apparmor.d}"
# A scratch directory a command removes on exit.
staging=""
# Set once `update --images` has loaded and checked the release's images, so
# the update builds none of them.
images_loaded=""
# The SSH signature namespace of an images manifest, beside git's for tags.
IMAGES_NAMESPACE=istota-images
# Exit codes: 1 a failure, 2 `apply` changed something, 3 the older image
# refused the database (rollback), 64 usage, 65 a tag refused.
EXIT_REFUSED_TAG=65
LATEST_BRANCH=main

# A lost terminal must not end the caller between two steps of a cleanup.
log() { echo "[istota-stack] $*" 2>/dev/null || true; }
die() { echo "[istota-stack] $*" >&2; exit 1; }
refuse_tag() { echo "[istota-stack] REFUSE: $*" >&2; exit "$EXIT_REFUSED_TAG"; }

usage() {
    sed -n '2,/^# --- end usage ---$/p' "$0" | grep -v '^# --- end usage ---$' | sed 's/^# \{0,1\}//'
}

# --- .env and host.env -------------------------------------------------------

env_get() {
    local file="$1" key="$2"
    [ -f "$file" ] || return 0
    awk -F= -v k="$key" '$1 == k { sub(/^[^=]*=/, ""); v = $0 } END { if (v != "") print v }' "$file"
}

# The workspace mount's directory on this VM, by host.env's STORAGE: the
# rclone mount's for nextcloud (and for local, which mounts nothing there), the
# folder Lima shares in for host-folder. provision.sh installs istota-stack and
# cannot source it, so each carries this; tests/test_host_units.py holds the
# two equal.
mount_dir_for_storage() {
    case "$1" in
        host-folder) echo /srv/mount/host-folder ;;
        *) echo /srv/mount/nextcloud/content ;;
    esac
}

MOUNT_DIR="${ISTOTA_MOUNT_DIR:-$(mount_dir_for_storage "$(env_get "$HOST_ENV" STORAGE)")}"

# host.env's APT_MIRROR, which the images' builds take as a build arg.
# provision.sh carries the same check; tests hold the two equal.
valid_apt_mirror() {
    [[ "$1" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~%-]+)+$ ]]
}

# Set KEY=VALUE pairs in .env, keeping every other line, through a rename so a
# reader never sees half a file.
env_set() {
    file_set "$ENV_FILE" "$@"
}

# The same for any env file of root's (.env, host.env).
file_set() {
    local file="$1" tmp
    shift
    tmp="$(mktemp "${file}.XXXXXX")"
    if [ -f "$file" ]; then cat "$file" > "$tmp"; fi
    while [ "$#" -gt 0 ]; do
        local key="${1%%=*}" value="${1#*=}"
        case "$value" in *$'\n'*|*$'\r'*) rm -f "$tmp"; die "a value for ${key} holds a line break" ;; esac
        # The value through the environment: awk -v would turn a literal \n
        # in it into a line of its own.
        FILE_SET_VALUE="$value" awk -F= -v k="$key" '
            BEGIN { v = ENVIRON["FILE_SET_VALUE"] }
            $1 == k { if (!done) { print k "=" v; done = 1 }; next }
            { print }
            END { if (!done) print k "=" v }' "$tmp" > "${tmp}.new"
        mv "${tmp}.new" "$tmp"
        shift
    done
    chmod 0644 "$tmp"
    mv "$tmp" "$file"
}

# --- the stack lock ----------------------------------------------------------

# One lock for every verb that writes, taken in main()'s dispatch so internal
# calls never take it again: flock(2) on .stack.lock through descriptor 9, which
# the holder keeps until it exits. The holder writes its verb into the file for
# the message a waiter prints. ISTOTA_STACK_LOCK_WAIT is the tests'.
STACK_LOCK="${STACK}/.stack.lock"
STACK_LOCK_WAIT="${ISTOTA_STACK_LOCK_WAIT:-600}"

lock_holder() {
    local verb
    verb="$(head -n 1 "$STACK_LOCK" 2>/dev/null || true)"
    echo "${verb:-another command}"
}

# take_stack_lock <verb> [--try]: wait up to STACK_LOCK_WAIT seconds for the
# lock, then fail naming the holder; with --try, answer 1 at once instead.
take_stack_lock() {
    local verb="$1" try="${2:-}"
    command -v flock >/dev/null 2>&1 || die "flock (util-linux) is missing; every command that writes holds the stack lock."
    exec 9>>"$STACK_LOCK" || die "could not open ${STACK_LOCK}"
    if ! flock -n 9; then
        if [ -n "$try" ]; then
            exec 9>&-
            return 1
        fi
        log "waiting for \`istota-stack $(lock_holder)\` to finish (up to ${STACK_LOCK_WAIT}s)"
        flock -w "$STACK_LOCK_WAIT" 9 \
            || die "\`istota-stack $(lock_holder)\` still holds ${STACK_LOCK}; nothing was done. Run this again once it has finished."
    fi
    printf '%s\n' "$verb" > "$STACK_LOCK"
}

refuse_busy_setup_web() {
    local holder
    holder="$(lock_holder)"
    case "$holder" in
        "setup --web") die "a setup is already running: \`istota-stack setup-code\` prints its address." ;;
        setup) die "a setup is already running (\`istota-stack setup\`)." ;;
        *) die "\`istota-stack ${holder}\` is running; run this again once it has finished." ;;
    esac
}

# Closing the descriptor drops the lock. Before handing control to anything
# that starts istota-stack.service: its ExecStart, `istota-stack up`, is not a
# child of this process and would wait for the lock this one holds.
release_stack_lock() {
    exec 9>&-
}

# --- compose -----------------------------------------------------------------

# Refuse a file this script would act on as root unless it is a regular file
# (not a link) owned by the user running this, writable by nobody else.
require_own_file() {
    local path="$1"
    if [ -z "$(find -P "$path" -maxdepth 0 -type f -user "$(id -u)" ! -perm -g+w ! -perm -o+w 2>/dev/null)" ]; then
        die "${path} is not a regular file owned by $(id -un) and writable by it alone; remove it and re-run \`istota-stack update <tag>\`."
    fi
}

compose() {
    local files=(-f "${SRC}/docker/docker-compose.yml") requests=""
    # The web config editor's trigger directory, on a VM provision.sh made one
    # on, and only from a checkout that has the file (a rollback may not).
    if [ -d "${STACK}/requests" ] && [ -f "${SRC}/docker/docker-compose.config-apply.yml" ]; then
        files+=(-f "${SRC}/docker/docker-compose.config-apply.yml")
        requests="${STACK}/requests"
    fi
    # WITHOUT_DEVBOX=1: the release's own file alone, for the steps of an
    # update that run before compose.devbox.yml is rendered again.
    # Its running devbox containers then look like orphans to compose, which
    # warns on every call; none of those steps removes orphans.
    local ignore_orphans=""
    if [ -n "${WITHOUT_DEVBOX:-}" ]; then
        ignore_orphans=1
    elif [ -e "$DEVBOX_COMPOSE" ] || [ -L "$DEVBOX_COMPOSE" ]; then
        require_own_file "$DEVBOX_COMPOSE"
        if [ -s "$DEVBOX_COMPOSE" ]; then files+=(-f "$DEVBOX_COMPOSE"); fi
    fi
    local certs="${STACK}/certs"
    if [ "$(env_get "$HOST_ENV" TLS_CERT_SOURCE)" = "acme" ]; then certs="${STACK}/letsencrypt"; fi
    local pin apt_mirror
    pin="$(env_get "$HOST_ENV" CLAUDE_CODE_VERSION)"
    apt_mirror="$(env_get "$HOST_ENV" APT_MIRROR)"
    if [ -n "$apt_mirror" ] && ! valid_apt_mirror "$apt_mirror"; then
        log "WARNING: APT_MIRROR '${apt_mirror}' is not an http(s) URL ending in a path; builds use deb.debian.org."
        apt_mirror=""
    fi
    # What the entrypoint requires at /mnt/shared: the filesystem type, and for
    # a host folder its .istota-workspace marker (an empty stand-in for a folder
    # that went away is a virtiofs mount too).
    local fstype="" marker=""
    case "$(env_get "$HOST_ENV" STORAGE)" in
        nextcloud) fstype=fuse.rclone ;;
        host-folder) fstype=virtiofs; marker=1 ;;
    esac
    (
        # Only a pin that is set: compose passes an empty variable as an empty
        # build arg, which overrides the Dockerfile's default and fails the build.
        if [ -n "$pin" ]; then export CLAUDE_CODE_VERSION="$pin"; else unset CLAUDE_CODE_VERSION; fi
        if [ -n "$apt_mirror" ]; then export APT_MIRROR="$apt_mirror"; else unset APT_MIRROR; fi
        # The image has no .git: the commit being built and its deployed name
        # are how a running stack says which code it is. Every build caller
        # sets ISTOTA_TAG and has the checkout at that commit.
        if [ -n "${ISTOTA_TAG:-}" ] && revision="$(verified_git rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null)"; then
            export ISTOTA_BUILD_REVISION="$revision" ISTOTA_BUILD_TAG="$ISTOTA_TAG"
        else
            unset ISTOTA_BUILD_REVISION ISTOTA_BUILD_TAG
        fi
        if [ -n "$requests" ]; then export ISTOTA_REQUESTS_DIR="$requests"; fi
        # A caller naming a tag means that tag's own image, for a build, the
        # devbox render or rollback's schema check: .env's ISTOTA_IMAGE is
        # the running tag's -cc layer, and a build would be tagged as it.
        # Empty rather than unset, since the environment outranks .env.
        if [ -n "${ISTOTA_TAG:-}" ]; then export ISTOTA_IMAGE=""; fi
        if [ -n "$ignore_orphans" ]; then export COMPOSE_IGNORE_ORPHANS=1; fi
        ISTOTA_SECRETS_DIR="$SECRETS_DIR" \
        ISTOTA_CONFIG_DIR="$CONFIG_DIR" \
        ISTOTA_DATA_DIR="$DATA_DIR" \
        ISTOTA_MOUNT_DIR="$MOUNT_DIR" \
        ISTOTA_WORKSPACE_FSTYPE="$fstype" \
        ISTOTA_WORKSPACE_MARKER_REQUIRED="$marker" \
        ISTOTA_HOST_ENV="$HOST_ENV" \
        CERTS_DIR="$certs" \
        ACME_WEBROOT="${STACK}/acme" \
        ISTOTA_LOG_DRIVER=journald \
            docker compose --project-name "$PROJECT" --env-file "$ENV_FILE" "${files[@]}" "$@"
    )
}

# The compose service the daemon runs as, read from the checkout's compose
# file: a rollback to a release from before the rename checks out a file that
# still calls it `istota`.
main_service() {
    if grep -qx '  istota:' "${SRC}/docker/docker-compose.yml" 2>/dev/null; then
        echo istota
    else
        echo daemon
    fi
}

# A one-shot container from the istota image, dropped to uid 10001 before
# anything runs: the root phase is bypassed, and `istota-drop` empties every
# capability set. ISTOTA_CONFIG_READ_ONLY=false makes /data/config writable for
# this container only.
oneshot() {
    local tty=(-T)
    if [ -t 0 ] && [ -t 1 ]; then tty=(); fi
    ensure_data_dir
    compose run --rm --no-deps "${tty[@]}" --entrypoint istota-drop "$@"
}

# The state directory: made on first use, and its mode reset on every start, so
# a directory left 0700 is corrected before the root phase meets it.
ensure_data_dir() {
    local owner=()
    if [ "$(id -u)" -eq 0 ]; then owner=(-o "$ISTOTA_UID" -g "$ISTOTA_UID"); fi
    [ -d "$DATA_DIR" ] || install -d -m "$DATA_MODE" ${owner[@]+"${owner[@]}"} "$DATA_DIR"
    chmod "$DATA_MODE" "$DATA_DIR"
}

# `docker compose exec` into the running daemon container, through `istota-drop`:
# an exec starts as uid 0 with the cap_add set, not from the daemon's state.
# ISTOTA_STACK_EXEC replaces the `compose exec daemon` prefix, so the image tier
# can point this at a container it started; the drop is not part of it.
stack_exec() {
    if [ -n "${ISTOTA_STACK_EXEC:-}" ]; then
        # Word-split on purpose: a command prefix.
        # shellcheck disable=SC2086
        ${ISTOTA_STACK_EXEC} istota-drop "$@"
        return
    fi
    local tty=(-T)
    if [ -t 0 ] && [ -t 1 ]; then tty=(); fi
    compose exec "${tty[@]}" "$(main_service)" istota-drop "$@"
}

# Copied into install.sh, host/cloud-init.yaml and the Mac's istota-stack, which
# run before any checkout exists; tests/test_host_units.py holds each copy byte
# for byte equal to this one.
# --- newest release ---
# The newest release among the tag names on stdin, one bare name per line: the
# highest vX.Y.Z by number (v0.10.0 is newer than v0.9.9). Prints nothing and
# fails when no name is one. It only picks: the caller verifies the tag. Not
# `sort -V`, which macOS's sort lacks.
newest_release_tag() {
    local newest
    newest="$(grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sed 's/^v//' \
        | sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)" || true
    [ -n "$newest" ] || return 1
    echo "v${newest}"
}
# --- end newest release ---

# --- release tags ------------------------------------------------------------

# git against the checkout, reading no configuration but this.
verified_git() {
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -C "$SRC" \
        -c gpg.format=ssh \
        -c "gpg.ssh.allowedSignersFile=${ALLOWED_SIGNERS}" \
        -c gpg.openpgp.program=false \
        -c gpg.x509.program=false \
        "$@"
}

check_tag_name() {
    case "$1" in
        ""|-*|*[!A-Za-z0-9._-]*|*..*) refuse_tag "'$1' is not a release tag name." ;;
    esac
}

# Print the object id of a release tag that passes every check, or refuse.
verify_release_tag() {
    local tag="$1" object kind named body
    check_tag_name "$tag"
    if ! object="$(verified_git rev-parse -q --verify "refs/tags/${tag}" 2>/dev/null)"; then
        refuse_tag "${tag} is not a tag in the checkout. Only a signed release tag is deployed, never a branch or a commit."
    fi
    kind="$(verified_git cat-file -t "$object")"
    if [ "$kind" != "tag" ]; then
        refuse_tag "${tag} is a lightweight tag; a release tag is annotated and signed."
    fi
    # Read once and tested as text: a `cat-file | grep -q` under pipefail
    # reads a match as a failure when grep closes the pipe early.
    body="$(verified_git cat-file tag "$object")"
    named="$(awk '/^tag / { print $2; exit } /^$/ { exit }' <<<"$body")"
    if [ "$named" != "$tag" ]; then
        refuse_tag "the ref ${tag} points at a tag object named '${named}'."
    fi
    if ! grep -qx -- '-----BEGIN SSH SIGNATURE-----' <<<"$body"; then
        refuse_tag "${tag} carries no SSH signature."
    fi
    if [ ! -s "$ALLOWED_SIGNERS" ]; then
        refuse_tag "${ALLOWED_SIGNERS} is missing or empty; provision.sh writes it from RELEASE_SIGNING_KEY."
    fi
    if ! verified_git verify-tag "$object" >/dev/null 2>&1; then
        refuse_tag "${tag} is not signed by the key in ${ALLOWED_SIGNERS}."
    fi
    echo "$object"
}

# --- builds and images -------------------------------------------------------

# Print the object id of any tag, signed or not: `update --unsigned`. Also a
# main-<hex> name `update --unsigned latest` recorded, as long as it is a commit
# of main.
resolve_unsigned_tag() {
    local tag="$1" object
    check_tag_name "$tag"
    if [[ "$tag" =~ ^${LATEST_BRANCH}-[0-9a-f]{12}$ ]]; then
        object="$(verified_git rev-parse -q --verify "${tag#"${LATEST_BRANCH}"-}^{commit}" 2>/dev/null)" \
            || refuse_tag "${tag} names no commit in the checkout."
        verified_git merge-base --is-ancestor "$object" "refs/remotes/origin/${LATEST_BRANCH}" \
            || refuse_tag "${tag} is not a commit of ${LATEST_BRANCH}."
        echo "$object"
        return
    fi
    if ! object="$(verified_git rev-parse -q --verify "refs/tags/${tag}" 2>/dev/null)"; then
        refuse_tag "${tag} is not a tag in the checkout. A branch or a commit is never deployed, signed or not."
    fi
    verified_git rev-parse -q --verify "${object}^{commit}" >/dev/null 2>&1 \
        || refuse_tag "${tag} does not point at a commit."
    echo "$object"
}

# Whether a config names a brain that runs Claude Code: config.toml, or the path
# given, which may be a plan.json (its `config` table is read). With no config
# yet, no: `istota-stack setup` says so when the answers need it.
# config_editor/handoff.py's needs_claude_code is the request's copy of the rule.
needs_claude_code() {
    local path="${1:-${CONFIG_DIR}/config.toml}"
    [ -f "$path" ] || { echo 0; return; }
    python3 - "$path" <<'PY'
import json, sys, tomllib
with open(sys.argv[1], "rb") as f:
    if sys.argv[1].endswith(".json"):
        document = json.load(f).get("config") or {}
    else:
        document = tomllib.load(f)
brain = document.get("brain", {})
kinds = {brain.get("kind", "claude_code"), brain.get("fallback", "")}
kinds |= set((brain.get("source_type_overrides") or {}).values())
kinds |= set(brain.get("room_selectable") or [])
print(1 if kinds & {"claude_code", "tmux_claude"} else 0)
PY
}

# `up -d`, then the containers of services no active profile names removed:
# compose counts a service whose profile was turned off as defined, so neither
# `down` nor `--remove-orphans` stops its container. One-off containers (setup,
# apply) are left alone.
stack_up() {
    local active id service
    ensure_data_dir
    # Rendered by the script that starts the stack, so it names this script's
    # /data: one an older istota-stack rendered names a volume nothing mounts.
    if [ -s "$DEVBOX_COMPOSE" ]; then
        render_devbox_compose "$(env_get "$ENV_FILE" ISTOTA_TAG)" \
            || die "the devbox compose file could not be rendered; the stack was not started."
    fi
    # Explicit: a caller on the left of `||` runs this with set -e off.
    compose up -d --remove-orphans || return $?
    active="$(compose config --services)"
    docker ps -a --filter "label=com.docker.compose.project=${PROJECT}" --filter label=com.docker.compose.oneoff=False \
            --format '{{.ID}} {{.Label "com.docker.compose.service"}}' | while read -r id service; do
        [ -n "$id" ] || continue
        if ! grep -qxF -- "$service" <<<"$active"; then
            log "removing the ${service} container: no active profile names it"
            docker rm -f "$id" >/dev/null || log "WARNING: could not remove the ${service} container (${id})"
        fi
    done
}

# An update or a rollback runs the outgoing release's istota-stack, and
# provision.sh runs the checkout's `up` after it. Where the two compose()
# functions pass compose different variables, the containers were recreated
# twice, so the checkout's own script brings the stack up, on the lock this
# process holds. One without the marker below (an older release) would wait on
# that lock instead.
release_stack_up() {
    local script="${SRC}/host/istota-stack"
    if [ -x "$script" ] && grep -q 'ISTOTA_STACK_LOCK_INHERITED' "$script"; then
        ISTOTA_STACK_LOCK_INHERITED=1 "$script" up
    else
        stack_up
    fi
}

# The services this stack builds. web runs the daemon service's
# image, so building them again would only repeat it.
build_services() {
    compose config --services | grep -vxE 'web|webhooks|nginx|signaling' || true
}

# The core images first, from the release's compose file alone: the
# compose.devbox.yml on disk was rendered by the previous release and may name
# what this one no longer has, which compose refuses for the whole project.
# Then the devbox file is rendered with the new image, and its images built.
# An INSTALL_CLAUDE_CODE already set wins over config.toml: config-apply builds
# for the config it is about to write.
build_images() {
    local tag="$1" services
    services="$(WITHOUT_DEVBOX=1 ISTOTA_TAG="$tag" build_services)"
    # shellcheck disable=SC2086
    BUILDX_BUILDER=default WITHOUT_DEVBOX=1 ISTOTA_TAG="$tag" INSTALL_CLAUDE_CODE="${INSTALL_CLAUDE_CODE:-$(needs_claude_code)}" \
        compose build $services
}

build_devbox_images() {
    local tag="$1" core devbox
    [ -s "$DEVBOX_COMPOSE" ] || return 0
    core="$(WITHOUT_DEVBOX=1 ISTOTA_TAG="$tag" compose config --services)"
    devbox="$(ISTOTA_TAG="$tag" compose config --services | grep -vxF -f <(printf '%s\n' "$core") || true)"
    [ -n "$devbox" ] || return 0
    # shellcheck disable=SC2086
    BUILDX_BUILDER=default ISTOTA_TAG="$tag" compose build $devbox
}

# Why the tag's image cannot run what config.toml (or the config path given)
# asks for, or nothing when it can: Claude Code missing where a brain needs it,
# or at another version than host.env's pin. A build reads the config, so the
# image follows whatever the config said at build time; this is what catches a
# config that changed since.
image_lacks_what_config_needs() {
    local tag="$1" config="${2:-}" env installed version pin
    [ "$(needs_claude_code ${config:+"$config"})" = 1 ] || return 0
    env="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$(stack_image "$tag")" 2>/dev/null || true)"
    installed="$(printf '%s\n' "$env" | sed -n 's/^ISTOTA_CLAUDE_CODE_INSTALLED=//p')"
    version="$(printf '%s\n' "$env" | sed -n 's/^ISTOTA_CLAUDE_CODE_VERSION=//p')"
    pin="$(env_get "$HOST_ENV" CLAUDE_CODE_VERSION)"
    if [ "$installed" != 1 ]; then
        echo "this config runs Claude Code, which the ${tag} image was built without"
    elif [ -n "$pin" ] && [ "$version" != "$pin" ]; then
        echo "the ${tag} image has Claude Code ${version}, and host.env pins ${pin}"
    fi
}

# A VM the Mac's `create --appliance` made: its images are a release's, loaded
# from the archive and built without Claude Code or Chrome.
desktop_app() {
    [ "$(env_get "$HOST_ENV" ISTOTA_DESKTOP_APP)" = 1 ]
}

# The command that gives a tag's stack what image_lacks_what_config_needs names.
image_remedy() {
    if desktop_app; then echo "istota-stack local-layers"; else echo "istota-stack update $1"; fi
}

# The image daemon and web run for a tag: its Claude Code layer when .env names
# it and it exists, else the tag's own.
stack_image() {
    local tag="$1" layer
    layer="$(cc_image "$tag")"
    if [ "$(env_get "$ENV_FILE" ISTOTA_IMAGE)" = "$layer" ] && docker image inspect "$layer" >/dev/null 2>&1; then
        echo "$layer"
    else
        echo "${IMAGE}:${tag}"
    fi
}

cc_image() { echo "${IMAGE}:$1-cc"; }

# .env's ISTOTA_IMAGE for a tag being switched to: its Claude Code layer when
# one was built for it (a rollback, or an update to the tag already running),
# else empty, and the tag's own image runs.
image_for_switch() {
    if docker image inspect "$(cc_image "$1")" >/dev/null 2>&1; then cc_image "$1"; fi
}

# The services this stack builds whose image for the tag does not exist, one
# per line. The set follows COMPOSE_PROFILES, so a setup that turned on a
# profile (the browser) names a service the tag's first build never built.
missing_service_images() {
    local tag="$1" service ref
    for service in $(WITHOUT_DEVBOX=1 ISTOTA_TAG="$tag" build_services); do
        ref="istota-${service}:${tag}"
        if [ "$service" = "$(main_service)" ]; then ref="${IMAGE}:${tag}"; fi
        docker image inspect "$ref" >/dev/null 2>&1 || echo "$service"
    done
}

# Keep the current and the previous tag's images, remove every other istota
# and istota-* image (istota-istota included, which older releases built).
prune_images() {
    local keep_current="$1" keep_previous="$2" ref tag
    docker image ls --format '{{.Repository}}:{{.Tag}}' | while read -r ref; do
        case "$ref" in "${IMAGE}":*|istota-*:*) ;; *) continue ;; esac
        tag="${ref##*:}"
        # A Claude Code layer goes with its tag.
        case "$ref" in "${IMAGE}":*-cc) tag="${tag%-cc}" ;; esac
        if [ "$tag" = "$keep_current" ] || [ "$tag" = "$keep_previous" ]; then continue; fi
        docker image rm "$ref" >/dev/null 2>&1 || log "could not remove ${ref}; in use?"
    done
}

# Compose labels its built images even after a rebuild leaves them untagged.
# No --all here: a tagged rollback image must survive without a container.
prune_build_artifacts() {
    log "pruning dangling Istota images"
    docker image prune --force --filter "label=com.docker.compose.project=${PROJECT}" \
        || log "WARNING: could not prune dangling Istota images"
    # The VM's default builder is also used explicitly by build_images and
    # build_devbox_images. Cache is shared; tagged images and volumes are not cache.
    log "pruning unused build cache (keep 2GB)"
    BUILDX_BUILDER=default docker builder prune --all --force --keep-storage 2GB \
        || log "WARNING: could not prune build cache"
}

# Read the retained pair at cleanup time: before a failed build it is still
# the old pair; after the switch it is the new one. Never remove volumes.
cleanup_update() {
    local current previous
    current="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    previous="$(env_get "$ENV_FILE" ISTOTA_PREVIOUS_TAG)"
    prune_images "$current" "$previous" || log "WARNING: could not prune older Istota images"
    prune_build_artifacts
}

render_devbox_compose() {
    local tag="$1" tmp
    [ -f "${CONFIG_DIR}/config.toml" ] || return 0
    tmp="$(mktemp)"
    if ! WITHOUT_DEVBOX=1 ISTOTA_TAG="$tag" oneshot "$(main_service)" istota devbox compose-file --state-dir "$DATA_DIR" > "$tmp"; then
        rm -f "$tmp"
        log "istota devbox compose-file failed"
        return 1
    fi
    if [ -n "$(python3 -c 'import json,sys; t=open(sys.argv[1]).read(); j=t[t.find("{"):] if "{" in t else "{}"; print("x" if json.loads(j).get("services") else "")' "$tmp")" ]; then
        install -m 0644 "$tmp" "$DEVBOX_COMPOSE"
    else
        rm -f "$DEVBOX_COMPOSE"
    fi
    rm -f "$tmp" "$LEGACY_DEVBOX_COMPOSE"
}

# Load the AppArmor profile the checkout ships, where the host has AppArmor.
# Loaded from a copy first and moved into place only once the kernel took it,
# so a profile that fails leaves the loaded one and the file on disk as they
# were. Returns non-zero on that failure; callers put things back.
load_apparmor() {
    local profile="${SRC}/docker/istota/apparmor-istota" tmp
    if ! command -v apparmor_parser >/dev/null 2>&1 || [ ! -d "$APPARMOR_SYSFS" ]; then
        return 0
    fi
    tmp="$(mktemp "${APPARMOR_DIR}/.istota.XXXXXX")" || return 1
    if ! install -m 0644 "$profile" "$tmp" || ! apparmor_parser -r "$tmp"; then
        rm -f "$tmp"
        log "the AppArmor profile ${profile} did not load"
        return 1
    fi
    mv "$tmp" "${APPARMOR_DIR}/istota"
}

# The name a commit of main is installed under: main-<first 12 hex>.
latest_name() {
    echo "${LATEST_BRANCH}-$(printf '%s' "$1" | cut -c1-12)"
}

# --- commands ----------------------------------------------------------------

# The release's tag from a git bundle, in place of origin: that one ref and
# nothing else. Without a `+` git will not move a tag the checkout already has,
# so a bundle cannot repoint a name an earlier update or a rollback trusts.
fetch_release_bundle() {
    local bundle="$1" tag="$2"
    case "$bundle" in /*) ;; *) bundle="${PWD}/${bundle}" ;; esac
    [ -f "$bundle" ] || die "${bundle} is not a file; nothing was changed."
    verified_git fetch --quiet --no-tags "$bundle" "refs/tags/${tag}:refs/tags/${tag}" \
        || die "could not take ${tag} from ${bundle} (no such tag in it, or a different ${tag} is already here); nothing was changed."
}

# --- release images ----------------------------------------------------------

refuse_images() { echo "[istota-stack] REFUSE: $*" >&2; exit "$EXIT_REFUSED_TAG"; }

# Whether some line of $3 has $2, exactly, as its field $1.
has_field() {
    awk -v n="$1" -v want="$2" '$n == want { found = 1 } END { exit !found }' <<<"$3"
}

# Whether the manifest's signature is good in the istota-images namespace for a
# principal allowed_signers trusts in it: the file and key tags are verified
# with, so `trust-signer` changes both together.
images_manifest_signed() {
    local manifest="$1" signature="$2" principal principals
    principals="$(ssh-keygen -Y find-principals -f "$ALLOWED_SIGNERS" -s "$signature" 2>/dev/null)" || return 1
    while IFS= read -r principal; do
        [ -n "$principal" ] || continue
        if ssh-keygen -Y verify -f "$ALLOWED_SIGNERS" -I "$principal" -n "$IMAGES_NAMESPACE" \
                -s "$signature" < "$manifest" >/dev/null 2>&1; then
            return 0
        fi
    done <<<"$principals"
    return 1
}

# The manifest's images as "<ref> <id>" lines, once it names this tag and the
# archive's digest; otherwise "REFUSE <why>" and a non-zero exit. Read only
# after the signature is good. Canonical JSON only (sorted keys, no whitespace),
# the form scripts/sign-images-manifest.sh writes, so no second parser can read
# one signed document another way. An istota image is named for this tag:
# another tag's are what rollback runs.
images_manifest_entries() {
    python3 -I - "$1" "$2" "$3" <<'PY'
import hashlib, json, re, sys

manifest, tag, archive = sys.argv[1:4]


def refuse(why):
    print(f"REFUSE {why}")
    sys.exit(2)


with open(manifest, encoding="utf-8") as f:
    text = f.read()
try:
    doc = json.loads(text)
except ValueError:
    refuse(f"{manifest} is not JSON")
if not isinstance(doc, dict) or json.dumps(doc, sort_keys=True, separators=(",", ":")) != text:
    refuse(f"{manifest} is not canonical JSON (sorted keys, no whitespace)")
if doc.get("tag") != tag:
    refuse(f"{manifest} is the manifest of {doc.get('tag')!r}, not {tag}")
expected = doc.get("archive_sha256")
if not isinstance(expected, str) or not re.fullmatch(r"[0-9a-f]{64}", expected):
    refuse(f"{manifest} names no archive SHA-256")
images = doc.get("images")
if not isinstance(images, list) or not images:
    refuse(f"{manifest} names no images")
seen = set()
for entry in images:
    if not isinstance(entry, dict) or set(entry) != {"ref", "id"}:
        refuse(f"{manifest} has an image entry that is not a ref and an id")
    ref, image_id = entry["ref"], entry["id"]
    if not isinstance(ref, str) or not re.fullmatch(r"[a-z0-9][a-z0-9._/-]*:[A-Za-z0-9._-]{1,128}", ref):
        refuse(f"{manifest} names an image by something other than name:tag: {ref!r}")
    if not isinstance(image_id, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", image_id):
        refuse(f"{manifest} gives {ref} no sha256 image ID")
    name, _, ref_tag = ref.rpartition(":")
    if (name == "istota" or name.startswith("istota-")) and ref_tag != tag:
        refuse(f"{manifest} names {ref}, an istota image of a tag other than {tag}")
    if ref in seen:
        refuse(f"{manifest} names {ref} twice")
    seen.add(ref)
digest = hashlib.sha256()
with open(archive, "rb") as f:
    for block in iter(lambda: f.read(1 << 20), b""):
        digest.update(block)
if digest.hexdigest() != expected:
    refuse(f"the SHA-256 of {archive} is {digest.hexdigest()}, and the manifest names {expected}")
for entry in images:
    print(entry["ref"], entry["id"])
PY
}

# Put back what a refused load replaced: each ref the manifest names on the ID
# it had before, or removed when it had none, and any other image the load
# reported removed. $1 is "<ref> <previous id, or ->" lines, $2 the load's output.
put_back_images() {
    local priors="$1" output="$2" ref prior current line
    while read -r ref prior; do
        [ -n "$ref" ] || continue
        current="$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null || true)"
        if [ "$prior" = "-" ]; then
            [ -z "$current" ] || docker image rm "$ref" >/dev/null 2>&1 || log "WARNING: could not remove ${ref}"
        elif [ "$current" != "$prior" ]; then
            docker image tag "$prior" "$ref" || log "WARNING: could not put ${ref} back on ${prior}"
        fi
    done <<<"$priors"
    while IFS= read -r line; do
        case "$line" in
            "Loaded image: "*) ref="${line#Loaded image: }" ;;
            "Loaded image ID: "*) ref="${line#Loaded image ID: }" ;;
            *) continue ;;
        esac
        has_field 1 "$ref" "$priors" && continue
        docker image rm "$ref" >/dev/null 2>&1 || log "WARNING: could not remove ${ref}"
    done <<<"$output"
}

# `update --images`: the release's images from DIR, under a manifest the release
# key signed, in place of a build. Every check before the load changes nothing;
# one that fails after it puts back what the load replaced.
load_release_images() {
    local dir="$1" tag="$2" archive manifest signature entries priors="" output ref id prior line wrong=""
    case "$dir" in /*) ;; *) dir="${PWD}/${dir}" ;; esac
    archive="${dir}/images-${tag}.tar"
    manifest="${dir}/images-${tag}.json"
    signature="${manifest}.sig"
    [ -f "$archive" ] && [ -f "$manifest" ] \
        || die "${dir} does not hold images-${tag}.tar and images-${tag}.json; nothing was changed."
    [ -f "$signature" ] || refuse_images "${manifest} is not signed (no ${signature}); nothing was changed."
    if ! images_manifest_signed "$manifest" "$signature"; then
        refuse_images "${manifest} is not signed by the key in ${ALLOWED_SIGNERS} for ${IMAGES_NAMESPACE} (its line must name namespaces=\"git,${IMAGES_NAMESPACE}\", as provision.sh writes it); nothing was changed."
    fi
    if ! entries="$(images_manifest_entries "$manifest" "$tag" "$archive")"; then
        refuse_images "${entries#REFUSE }; nothing was changed."
    fi

    while read -r ref id; do
        prior="$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null || true)"
        priors+="${ref} ${prior:--}"$'\n'
    done <<<"$entries"
    log "loading the images of ${tag} from ${archive}"
    if ! output="$(docker load -i "$archive")"; then
        put_back_images "$priors" "$output"
        die "docker load of ${archive} failed; .env, the checkout and the running stack are unchanged."
    fi
    # Every image the archive held is one the manifest names, and every name
    # the manifest gives is on the ID it gives.
    while IFS= read -r line; do
        case "$line" in
            "Loaded image: "*)
                ref="${line#Loaded image: }"
                has_field 1 "$ref" "$priors" || wrong="${ref} is in the archive and not in the manifest" ;;
            "Loaded image ID: "*)
                id="${line#Loaded image ID: }"
                has_field 2 "$id" "$entries" || wrong="the archive holds ${id}, which the manifest does not name" ;;
        esac
    done <<<"$output"
    while read -r ref id; do
        [ "$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null || true)" = "$id" ] \
            || wrong="${ref} did not load as ${id}"
    done <<<"$entries"
    if [ -n "$wrong" ]; then
        put_back_images "$priors" "$output"
        refuse_images "${wrong}; the loaded images were removed, and .env, the checkout and the running stack are unchanged."
    fi
    log "the images of ${tag} loaded, and match the signed manifest"
}

# --- local layers ------------------------------------------------------------

# Each layer's last run, for `--status`: <layer>.state (state, tag, pid) and
# <layer>.log, the build's output. Root's.
LOCAL_LAYERS_DIR="${STACK}/local-layers"
LOCAL_LAYER_NAMES="claude-code chrome"
BROWSER_BASE_IMAGE=istota-browser-base
BROWSER_IMAGE=istota-browser

# host.env's ISTOTA_LOCAL_LAYERS, separated by spaces or commas, quotes
# dropped; every layer when the key is absent.
wanted_local_layers() {
    local value name
    if ! grep -q '^ISTOTA_LOCAL_LAYERS=' "$HOST_ENV" 2>/dev/null; then
        echo "$LOCAL_LAYER_NAMES"
        return
    fi
    value="$(env_get "$HOST_ENV" ISTOTA_LOCAL_LAYERS | tr -d "\"'" | tr ',' ' ')"
    for name in $value; do
        case " ${LOCAL_LAYER_NAMES} " in
            *" ${name} "*) printf '%s ' "$name" ;;
            *) log "WARNING: ISTOTA_LOCAL_LAYERS names '${name}', which is no layer (${LOCAL_LAYER_NAMES})" >&2 ;;
        esac
    done
    echo
}

layer_wanted() {
    case " $(wanted_local_layers) " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

layer_state_set() {
    local layer="$1" state="$2" tag="$3" tmp
    install -d -m 0700 "$LOCAL_LAYERS_DIR"
    tmp="$(mktemp "${LOCAL_LAYERS_DIR}/.${layer}.XXXXXX")"
    printf 'state=%s\ntag=%s\npid=%s\n' "$state" "$tag" "$$" > "$tmp"
    mv "$tmp" "${LOCAL_LAYERS_DIR}/${layer}.state"
}

# The version the Claude Code layer installs: host.env's pin, else the one the
# release's image was built for (its Dockerfile's default), so the pin is the
# release's.
claude_code_layer_version() {
    local tag="$1" version
    version="$(env_get "$HOST_ENV" CLAUDE_CODE_VERSION)"
    if [ -z "$version" ]; then
        version="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "${IMAGE}:${tag}" 2>/dev/null \
            | sed -n 's/^ISTOTA_CLAUDE_CODE_VERSION=//p' || true)"
    fi
    echo "$version"
}

# Whether a layer's image is there for the tag: Claude Code's at the version
# it would install, and named by .env so the stack runs it.
layer_ready() {
    local layer="$1" tag="$2" image env
    case "$layer" in
        claude-code)
            image="$(cc_image "$tag")"
            [ "$(env_get "$ENV_FILE" ISTOTA_IMAGE)" = "$image" ] || return 1
            env="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$image" 2>/dev/null)" || return 1
            [ "$(printf '%s\n' "$env" | sed -n 's/^ISTOTA_CLAUDE_CODE_VERSION=//p')" = "$(claude_code_layer_version "$tag")" ] ;;
        chrome)
            docker image inspect "${BROWSER_IMAGE}:${tag}" >/dev/null 2>&1 ;;
    esac
}

# FROM the release's image, the npm install docker/istota/Dockerfile runs when
# INSTALL_CLAUDE_CODE=1, and the two variables check-image and doctor read.
build_claude_code_layer() {
    local tag="$1" log="$2" version dockerfile rc=0
    version="$(claude_code_layer_version "$tag")"
    if ! [[ "$version" =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]]; then
        echo "no Claude Code version to install: ${IMAGE}:${tag} names none and host.env pins none" > "$log"
        return 1
    fi
    dockerfile="$(mktemp)"
    # The variables are the Dockerfile's, expanded by docker, not here.
    # shellcheck disable=SC2016
    printf 'FROM %s\nARG CLAUDE_CODE_VERSION\nRUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"\nENV ISTOTA_CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION} ISTOTA_CLAUDE_CODE_INSTALLED=1\n' \
        "${IMAGE}:${tag}" > "$dockerfile"
    BUILDX_BUILDER=default docker build --build-arg "CLAUDE_CODE_VERSION=${version}" \
        -t "$(cc_image "$tag")" - < "$dockerfile" > "$log" 2>&1 || rc=$?
    rm -f -- "$dockerfile"
    return "$rc"
}

# The checkout's browser Dockerfile, its chrome stage on the release's base
# image rather than on a base built here.
build_chrome_layer() {
    local tag="$1" log="$2"
    if ! docker image inspect "${BROWSER_BASE_IMAGE}:${tag}" >/dev/null 2>&1; then
        echo "there is no ${BROWSER_BASE_IMAGE}:${tag} image to build Chrome on" > "$log"
        return 1
    fi
    BUILDX_BUILDER=default docker build --build-arg "BROWSER_BASE=${BROWSER_BASE_IMAGE}:${tag}" \
        --target chrome -t "${BROWSER_IMAGE}:${tag}" "${SRC}/docker/browser" > "$log" 2>&1
}

# Build each wanted layer the tag lacks, drop the Claude Code layer when it is
# not wanted, and recreate a running stack whose image changed. Non-zero when a
# wanted layer is not ready. update calls it on the left of ||, where set -e
# is off, so each step checks its own status.
run_local_layers() {
    local tag="$1" layer rc=0 before after
    before="$(env_get "$ENV_FILE" ISTOTA_IMAGE)"
    install -d -m 0700 "$LOCAL_LAYERS_DIR"
    for layer in $LOCAL_LAYER_NAMES; do
        if ! layer_wanted "$layer"; then
            if [ "$layer" = claude-code ] && [ -n "$before" ]; then
                log "Claude Code is not wanted (ISTOTA_LOCAL_LAYERS); the stack goes back to ${IMAGE}:${tag}"
                env_set "ISTOTA_IMAGE="
            fi
            (cd "$LOCAL_LAYERS_DIR" && rm -f -- "${layer}.state" "${layer}.log")
            continue
        fi
        if layer_ready "$layer" "$tag"; then
            layer_state_set "$layer" ready "$tag"
            continue
        fi
        log "building the ${layer} layer for ${tag}"
        layer_state_set "$layer" building "$tag"
        if "build_${layer//-/_}_layer" "$tag" "${LOCAL_LAYERS_DIR}/${layer}.log"; then
            if [ "$layer" = claude-code ]; then env_set "ISTOTA_IMAGE=$(cc_image "$tag")"; fi
            layer_state_set "$layer" ready "$tag"
            log "the ${layer} layer is ready"
        else
            layer_state_set "$layer" failed "$tag"
            log "the ${layer} layer failed: ${LOCAL_LAYERS_DIR}/${layer}.log"
            rc=1
        fi
    done
    after="$(env_get "$ENV_FILE" ISTOTA_IMAGE)"
    if [ "$after" != "$before" ] && [ -f "${CONFIG_DIR}/config.toml" ] \
            && [ -n "$(compose ps -q "$(main_service)" 2>/dev/null)" ]; then
        log "recreating daemon and web on ${after:-${IMAGE}:${tag}}"
        stack_up || { log "the stack did not come up on ${after:-${IMAGE}:${tag}}"; rc=1; }
    fi
    if [ -z "$after" ] && [ -n "$before" ]; then
        docker image rm "$before" >/dev/null 2>&1 || log "WARNING: could not remove ${before}"
    fi
    return "$rc"
}

# One JSON line per layer for the app: building while a run that is still
# alive says so, ready when the image is there, failed with the build's last
# lines when this tag's last run failed or died, otherwise absent.
local_layers_status() {
    local tag layer file state state_tag pid detail
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    for layer in $LOCAL_LAYER_NAMES; do
        file="${LOCAL_LAYERS_DIR}/${layer}.state"
        state="$(env_get "$file" state)"
        state_tag="$(env_get "$file" tag)"
        pid="$(env_get "$file" pid)"
        detail=""
        if [ -z "$tag" ]; then
            state=absent; detail="no release is installed"
        elif [ "$state" = building ] && [ "$state_tag" = "$tag" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            detail="building for ${tag}"
        elif ! layer_wanted "$layer"; then
            state=absent; detail="not wanted: ISTOTA_LOCAL_LAYERS in host.env leaves it out"
        elif layer_ready "$layer" "$tag"; then
            state=ready
        elif [ "$state_tag" = "$tag" ] && { [ "$state" = failed ] || [ "$state" = building ]; }; then
            if [ "$state" = building ]; then
                detail="the run building it ended before it finished"
            else
                detail="$(tail -n 20 "${LOCAL_LAYERS_DIR}/${layer}.log" 2>/dev/null || true)"
            fi
            state=failed
        else
            state=absent
        fi
        python3 -I -c 'import json, sys; print(json.dumps({"layer": sys.argv[1], "state": sys.argv[2], "detail": sys.argv[3]}))' \
            "$layer" "$state" "$detail"
    done
}

cmd_local_layers() {
    case "${1:-}" in
        --status) [ "$#" -eq 1 ] || { usage >&2; exit 64; }; local_layers_status; return ;;
        "") ;;
        *) usage >&2; exit 64 ;;
    esac
    local tag
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    [ -n "$tag" ] || die "no release is installed yet: \`istota-stack update <tag>\` first."
    run_local_layers "$tag" || exit 1
}

cmd_update() {
    local unsigned="" bundle="" images="" tag="" tags=0 newest=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --unsigned) unsigned=1 ;;
            --bundle)
                [ "$#" -ge 2 ] || { usage >&2; exit 64; }
                bundle="$2"
                shift ;;
            --images)
                [ "$#" -ge 2 ] || { usage >&2; exit 64; }
                images="$2"
                shift ;;
            *) tag="$1"; tags=$((tags + 1)) ;;
        esac
        shift
    done
    if [ -n "$bundle" ] && [ -n "$unsigned" ]; then
        refuse_tag "--bundle installs only a signed release; --unsigned is refused with it."
    fi
    if [ -n "$images" ] && [ -n "$unsigned" ]; then
        refuse_tag "--images loads only a signed release's images; --unsigned is refused with it."
    fi
    if [ "$tags" -eq 0 ] && [ -z "$unsigned" ] && [ -z "$bundle" ] && [ -z "$images" ]; then
        newest=1
    elif [ "$tags" -ne 1 ]; then
        usage >&2; exit 64
    fi
    local object before
    [ -n "$newest" ] || check_tag_name "$tag"
    [ -d "${SRC}/.git" ] || die "${SRC} is not a git checkout; provision.sh clones it."
    if [ -n "$bundle" ]; then
        fetch_release_bundle "$bundle" "$tag"
    else
        verified_git fetch --quiet --tags origin \
            "+refs/heads/${LATEST_BRANCH}:refs/remotes/origin/${LATEST_BRANCH}" \
            || die "git fetch failed; nothing was changed."
    fi
    if [ -n "$newest" ]; then
        tag="$(verified_git tag --list | newest_release_tag)" \
            || die "origin has no release tag (vX.Y.Z); \`istota-stack update <tag>\` names one. Nothing was changed."
        if [ "$tag" = "$(env_get "$ENV_FILE" ISTOTA_TAG)" ] && [ -z "$(env_get "$ENV_FILE" ISTOTA_TAG_UNSIGNED)" ]; then
            log "already on ${tag}, the newest release"
            exit 0
        fi
        log "the newest release is ${tag}"
    elif [ "$tag" = latest ]; then
        [ -n "$unsigned" ] || refuse_tag "latest follows ${LATEST_BRANCH}, which is never signed: \`istota-stack update --unsigned latest\`."
        tag="$(latest_name "$(verified_git rev-parse --verify "refs/remotes/origin/${LATEST_BRANCH}^{commit}")")"
    fi
    if [ -n "$unsigned" ]; then
        object="$(resolve_unsigned_tag "$tag")"
        log "${tag}: installing without a signature check (--unsigned)"
    elif ! object="$(verify_release_tag "$tag")"; then
        if [ -n "$newest" ]; then
            # Never an older tag in its place: that is a downgrade nobody asked for.
            echo "[istota-stack] ${tag} is the newest release tag; nothing was installed. \`istota-stack update <tag>\` installs another." >&2
        else
            echo "[istota-stack] Only releases are signed: \`istota-stack update --unsigned ${tag}\` installs any other tag." >&2
        fi
        exit "$EXIT_REFUSED_TAG"
    fi
    if [ -n "$images" ]; then
        load_release_images "$images" "$tag"
        images_loaded=1
    fi
    before="$(verified_git rev-parse HEAD)"
    prune_build_artifacts
    trap cleanup_update EXIT

    # From here until .env is written, a failure puts the checkout back, so .env,
    # the checkout and the running stack all stay as they were.
    verified_git checkout --quiet --detach "${object}^{commit}"
    hand_update_to_release "$tag" "$unsigned" "$before" "$(verified_git rev-parse HEAD)"
    update_from_checkout "$tag" "$unsigned" "$before"
}

# The rest of an update belongs to the release being installed: its own
# istota-stack builds, renders the devbox file, writes .env, starts the stack and
# provisions the host. The script running this one is the previous release's,
# and a change a release makes to those steps (the state directory, the devbox
# render) otherwise reached a host only on the update after. The checkout was
# verified above, as provision.sh is. A release without the handoff (an older
# one) finishes here. The child holds the lock through descriptor 9.
hand_update_to_release() {
    local tag="$1" unsigned="$2" before="$3" commit="$4" script="${SRC}/host/istota-stack"
    [ -z "${ISTOTA_STACK_UPDATE_HANDOFF:-}" ] || return 0
    [ -x "$script" ] && grep -q 'ISTOTA_STACK_UPDATE_HANDOFF' "$script" || return 0
    # One that does not know ISTOTA_STACK_IMAGES_LOADED would build the images.
    if [ -n "$images_loaded" ] && ! grep -q 'ISTOTA_STACK_IMAGES_LOADED' "$script"; then
        return 0
    fi
    log "handing the update to ${tag}'s own istota-stack"
    trap - EXIT
    exec env ISTOTA_STACK_UPDATE_HANDOFF=1 ISTOTA_STACK_LOCK_INHERITED=1 \
        ISTOTA_STACK_IMAGES_LOADED="$images_loaded" \
        "$BASH" "$script" update-from-checkout "$tag" "$unsigned" "$before" "$commit"
}

# Only ever exec'd by hand_update_to_release: it skips the fetch and the tag
# check, so it refuses unless it holds the update's lock and the checkout is the
# commit that check passed.
cmd_update_from_checkout() {
    [ "$#" -eq 4 ] || { usage >&2; exit 64; }
    local tag="$1" unsigned="$2" before="$3" commit="$4"
    [ -n "${ISTOTA_STACK_UPDATE_HANDOFF:-}" ] && flock -n 9 2>/dev/null \
        || die "update-from-checkout is the second half of \`istota-stack update\`; run that instead."
    check_tag_name "$tag"
    [ "$(verified_git rev-parse HEAD)" = "$commit" ] \
        || die "the checkout is not the commit the update verified; nothing was changed."
    images_loaded="${ISTOTA_STACK_IMAGES_LOADED:-}"
    trap cleanup_update EXIT
    update_from_checkout "$tag" "$unsigned" "$before"
}

update_from_checkout() {
    local tag="$1" unsigned="$2" before="$3" current current_unsigned previous previous_unsigned up_rc=0
    current="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    current_unsigned="$(env_get "$ENV_FILE" ISTOTA_TAG_UNSIGNED)"
    if [ -n "$images_loaded" ]; then
        log "${tag}'s images came from its signed archive; building only the devbox images"
    else
        log "building ${tag}"
    fi
    if { [ -z "$images_loaded" ] && ! build_images "$tag"; } \
            || ! render_devbox_compose "$tag" || ! build_devbox_images "$tag"; then
        verified_git checkout --quiet --detach "$before" || true
        die "building ${tag} failed; .env, the checkout and the running stack are unchanged."
    fi
    if ! load_apparmor; then
        verified_git checkout --quiet --detach "$before" || true
        die "${tag}'s AppArmor profile did not load; .env, the checkout and the running stack are unchanged."
    fi
    # A secret this tag's compose file declares and setup never created: compose
    # refuses to start a service whose secret file is missing.
    if ! ensure_secret_files; then
        verified_git checkout --quiet --detach "$before" || true
        die "could not create ${tag}'s secret files in ${SECRETS_DIR}; .env and the running stack are unchanged."
    fi

    previous="$current"
    previous_unsigned="$current_unsigned"
    if [ "$current" = "$tag" ]; then
        previous="$(env_get "$ENV_FILE" ISTOTA_PREVIOUS_TAG)"
        previous_unsigned="$(env_get "$ENV_FILE" ISTOTA_PREVIOUS_TAG_UNSIGNED)"
    fi
    env_set "ISTOTA_TAG=${tag}" "ISTOTA_TAG_UNSIGNED=${unsigned}" \
        "ISTOTA_PREVIOUS_TAG=${previous}" "ISTOTA_PREVIOUS_TAG_UNSIGNED=${previous_unsigned}" \
        "ISTOTA_IMAGE=$(image_for_switch "$tag")"
    if [ -f "${CONFIG_DIR}/config.toml" ]; then
        release_stack_up || up_rc=$?
    else
        log "no config yet: run \`istota-stack setup --web\` to set it up in a browser, or \`istota-stack setup\` in the terminal."
    fi
    # After the stack is up, so a layer that cannot be fetched holds nothing
    # back; it reports, and the next `local-layers` tries again.
    if [ -n "$images_loaded" ] && [ "$up_rc" -eq 0 ] && [ -f "${CONFIG_DIR}/config.toml" ]; then
        run_local_layers "$tag" || log "WARNING: a local layer did not build (\`istota-stack local-layers --status\`); the stack runs ${tag}'s own images."
    fi
    copy_stack_env_out
    cleanup_update
    # A successful update may exec provision.sh, which does not run EXIT traps.
    trap - EXIT
    if [ "$up_rc" -ne 0 ]; then
        # Provisioned all the same: provision.sh installs this release's
        # istota-stack, and a host left on the old one fails the next update too.
        log "WARNING: the stack did not come up on ${tag} (exit ${up_rc}); .env names it, and the host is provisioned for it anyway."
    else
        log "now on ${tag} (previous: ${previous:-none})"
    fi
    reprovision_if_changed
    [ "$up_rc" -eq 0 ] || die "the stack did not come up on ${tag}; \`istota-stack compose ps\` and \`docker logs istota-daemon-1\` say why."
}

# provision.sh installs this script, the units and the host scripts, so a
# checkout that changed them, by update or by rollback, is provisioned straight
# after the stack runs it. Last and by exec: provision.sh replaces the file bash
# is reading this from.
reprovision_if_changed() {
    provision_outdated || return 0
    log "the host's provisioning inputs changed; running ${SRC}/host/provision.sh (the stack already runs $(env_get "$ENV_FILE" ISTOTA_TAG))"
    # provision.sh runs `istota-stack up` and may restart istota-stack.service,
    # whose ExecStart is `up`; with the lock held across the exec, through the
    # inherited descriptor, that `up` would wait on its own parent.
    release_stack_lock
    exec "${SRC}/host/provision.sh"
}

# Whether the checkout's provision.sh would act on inputs other than the ones
# its last successful run recorded in .provisioned.
provision_outdated() {
    local provision="${SRC}/host/provision.sh" digest
    [ -x "$provision" ] || return 1
    digest="$("$provision" --digest 2>/dev/null || true)"
    [ -z "$digest" ] || [ "$digest" != "$(cat "${STACK}/.provisioned" 2>/dev/null || true)" ]
}

cmd_rollback() {
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    local current current_unsigned previous previous_unsigned object rc=0
    current="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    current_unsigned="$(env_get "$ENV_FILE" ISTOTA_TAG_UNSIGNED)"
    previous="$(env_get "$ENV_FILE" ISTOTA_PREVIOUS_TAG)"
    previous_unsigned="$(env_get "$ENV_FILE" ISTOTA_PREVIOUS_TAG_UNSIGNED)"
    [ -n "$previous" ] || die "no previous tag in ${ENV_FILE}; nothing to roll back to."
    # A release from before the rename built its image as istota-istota. The
    # schema check below runs it under this compose file's name, and compose
    # would build a missing image from this checkout rather than fail.
    if ! docker image inspect "${IMAGE}:${previous}" >/dev/null 2>&1 \
            && docker image inspect "${LEGACY_IMAGE}:${previous}" >/dev/null 2>&1; then
        docker image tag "${LEGACY_IMAGE}:${previous}" "${IMAGE}:${previous}"
    fi
    docker image inspect "${IMAGE}:${previous}" >/dev/null 2>&1 \
        || die "the image ${IMAGE}:${previous} is gone; run \`istota-stack update ${previous}\`."
    if [ -n "$previous_unsigned" ]; then
        object="$(resolve_unsigned_tag "$previous")"
    else
        object="$(verify_release_tag "$previous")"
    fi
    # Ask the older image whether it can run this database before switching to
    # it: a newer release's migration may have been one-way.
    ISTOTA_TAG="$previous" oneshot "$(main_service)" istota init --check-schema || rc=$?
    if [ "$rc" -eq 3 ]; then
        echo "[istota-stack] REFUSE: ${previous} cannot run this database: a newer release migrated it. ${ENV_FILE} still names ${current}." >&2
        exit 3
    elif [ "$rc" -ne 0 ]; then
        die "${previous} could not check the database (exit ${rc}); ${ENV_FILE} still names ${current}."
    fi

    local before
    before="$(verified_git rev-parse HEAD)"
    verified_git checkout --quiet --detach "${object}^{commit}"
    if ! load_apparmor; then
        verified_git checkout --quiet --detach "$before" || true
        die "${previous}'s AppArmor profile did not load; ${ENV_FILE} still names ${current}."
    fi
    env_set "ISTOTA_TAG=${previous}" "ISTOTA_TAG_UNSIGNED=${previous_unsigned}" \
        "ISTOTA_PREVIOUS_TAG=${current}" "ISTOTA_PREVIOUS_TAG_UNSIGNED=${current_unsigned}" \
        "ISTOTA_IMAGE=$(image_for_switch "$previous")"
    release_stack_up
    log "rolled back to ${previous} (previous: ${current})"
    reprovision_if_changed
}

# Every credential file compose declares, empty where it does not exist yet:
# compose refuses to start a service whose secret file is missing, before
# anything in a container could write one.
secret_names() {
    # Names are [a-z0-9_] only; the single quotes are sed's, not the shell's.
    # shellcheck disable=SC2016
    sed -n 's|^ *file: \${ISTOTA_SECRETS_DIR:-\./secrets}/\([a-z0-9_]*\)$|\1|p' "${SRC}/docker/docker-compose.yml"
}

ensure_secret_files() {
    local name owner=() request rc=0
    # Root on the VM; the tests run as themselves.
    if [ "$(id -u)" -eq 0 ]; then owner=(-o "$ISTOTA_UID" -g "$ISTOTA_UID"); fi
    install -d -m 0700 "${owner[@]}" "$SECRETS_DIR" || return 1
    # The files themselves go through put-files: secrets/ is uid 10001's.
    request='{"secrets": {'
    for name in $(secret_names); do
        request="${request}\"${name}\": null, "
    done
    request="${request%, }}}"
    printf '%s' "$request" | cmd_put_files >/dev/null || rc=$?
    [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ]
}

# Copy a file the wizard wrote in staging into place, 0644 unless a third
# argument names the mode, refusing a link or anything but a plain file:
# staging is uid 10001's, and root following a link planted there would copy
# whatever root can read into .env.
install_staged() {
    python3 - "$1" "$2" "${3:-0644}" <<'PY'
import os, stat, sys
src, dst, mode = sys.argv[1], sys.argv[2], int(sys.argv[3], 8)
try:
    fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except OSError as exc:
    sys.exit(f"[istota-stack] REFUSE: {src}: {exc.strerror}; setup left something other than a file there")
with os.fdopen(fd, "rb") as fh:
    info = os.fstat(fh.fileno())
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        sys.exit(f"[istota-stack] REFUSE: {src} is not a plain file")
    data = fh.read(1 << 20)
tmp = f"{dst}.staged.{os.getpid()}"
out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
with os.fdopen(out, "wb") as fh:
    fh.write(data)
os.chmod(tmp, mode)
os.replace(tmp, dst)
PY
}

# What the wizard staged, into place. rclone.conf is there only when the
# answers use Nextcloud; it carries the obscured app password, so it is 0600,
# and provision.sh hands it to uid 10001 for the mount.
install_setup_staging() {
    local staging="$1"
    install_staged "${staging}/.env" "$ENV_FILE"
    install_staged "${staging}/host.env" "$HOST_ENV"
    if [ -e "${staging}/rclone.conf" ] || [ -L "${staging}/rclone.conf" ]; then
        install_staged "${staging}/rclone.conf" "${STACK}/rclone.conf" 0600
        # install_staged leaves root's inode, and provision.sh, which hands it
        # to the mount, does not run when the bytes did not change (#720).
        chown "$ISTOTA_UID:$ISTOTA_UID" "${STACK}/rclone.conf"
    fi
}

# What either setup needs before the wizard runs: the directories and every
# secret file compose declares.
prepare_setup() {
    local owner=()
    # Root on the VM; the tests run as themselves.
    if [ "$(id -u)" -eq 0 ]; then owner=(-o "$ISTOTA_UID" -g "$ISTOTA_UID"); fi
    install -d -m 0750 ${owner[@]+"${owner[@]}"} "$CONFIG_DIR"
    install -d -m 0755 "${STACK}/certs" "${STACK}/letsencrypt" "${STACK}/acme"
    # A host folder is the user's own on the Mac, and a mode set here reaches it.
    local host_folder=""
    [ "$(env_get "$HOST_ENV" STORAGE)" != "host-folder" ] || host_folder=1
    [ -n "$host_folder" ] || install -d -m 0755 "$MOUNT_DIR"
    ensure_secret_files
}

# The wizard runs as uid 10001 and writes .env, host.env and secrets/ in its
# --vm-dir, so it gets a staging directory, handed to 10001 by the caller once
# root has put in everything it copies; the files are moved into place as root
# afterwards. The current .env and host.env go in, so the wizard keeps the
# lines it does not own, and rclone.conf, so a re-run with the same answers
# keeps it byte for byte rather than re-salting the password (#720).
new_staging() {
    staging="$(mktemp -d "${STACK}/.setup.XXXXXX")"
    for f in .env host.env rclone.conf; do
        if [ -f "${STACK}/${f}" ]; then cp "${STACK}/${f}" "${staging}/${f}"; fi
    done
}

# The root-owned files a `--force` re-run replaces, copied first to
# backups/setup-<UTC stamp>.<suffix>/ (0700), the newest ten kept. The config
# and the secrets are 10001's, and the wizard backs up config.toml itself.
backup_stack_env() {
    local dir f old=() i
    install -d -m 0700 "${STACK}/backups"
    dir="$(mktemp -d "${STACK}/backups/setup-$(date -u +%Y%m%dT%H%M%SZ).XXXXXX")"
    STACK_ENV_BACKUP="$dir"
    for f in .env host.env rclone.conf; do
        if [ -f "${STACK}/${f}" ] && [ ! -L "${STACK}/${f}" ]; then
            cp -p "${STACK}/${f}" "${dir}/${f}"
        fi
    done
    for f in "${STACK}"/backups/setup-*; do
        if [ -d "$f" ]; then old+=("$f"); fi
    done
    for ((i = 0; i < ${#old[@]} - 10; i++)); do rm -rf -- "${old[$i]}"; done
    log "the current .env, host.env and rclone.conf are in ${dir}"
}

cmd_setup() {
    case " $* " in *" --web "*) cmd_setup_web "$@" ;; esac
    local tag
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    [ -n "$tag" ] || die "no image yet: run \`istota-stack update <tag>\` first."
    case " $* " in *" --force "*) backup_stack_env ;; esac
    prepare_setup

    trap 'rm -rf "${staging:-}"' EXIT
    new_staging
    chown -R "$ISTOTA_UID:$ISTOTA_UID" "$staging"
    # A non-interactive run takes credentials from the environment under the
    # names the daemon reads (ANTHROPIC_API_KEY, ISTOTA_NEXTCLOUD_APP_PASSWORD,
    # ...). `-e NAME` hands each one through by name, so no value is on a
    # command line. ISTOTA_SECRETS_DIR=/nonexistent turns istota-secrets'
    # export off: the stored files would outrank a value passed here, and the
    # wizard reads them from /vm/secrets as the current answers.
    local name var pass=(-e ISTOTA_SECRETS_DIR=/nonexistent)
    for name in $(secret_names); do
        var="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
        if [ -n "${!var:-}" ]; then pass+=(-e "$var"); fi
    done
    ISTOTA_CONFIG_READ_ONLY=false oneshot "${pass[@]}" \
        -v "${staging}:/vm" -v "${SECRETS_DIR}:/vm/secrets" \
        "$(main_service)" istota setup --vm-dir /vm "$@"
    # Nothing running as 10001 may change staging while root reads it.
    chown root:root "$staging"
    chmod 0700 "$staging"
    install_setup_staging "$staging"
    # The wizard owns .env's keys but not this script's.
    env_set "ISTOTA_TAG=${tag}"
    local lacking
    lacking="$(image_lacks_what_config_needs "$tag")"
    if [ -n "$lacking" ]; then
        log "${lacking}: run \`$(image_remedy "$tag")\`."
    fi
    render_devbox_compose "$tag"
    copy_stack_env_out
    log "written. Re-run provision.sh to pick up host.env, then \`systemctl enable --now istota-stack\`."
}

# --- setup --web --------------------------------------------------------------

refuse_if_set_up() {
    if [ -e "${CONFIG_DIR}/config.toml" ]; then
        die "istota is already set up (${CONFIG_DIR}/config.toml exists). Change it on the admin Configuration page, in a browser with \`istota-stack setup --web --force\`, or in the terminal with \`istota-stack setup --force\`."
    fi
}

# The setup server's container, named so an abandoned run and `setup-cancel`
# can remove it: it holds the port nginx needs and the inherited lock.
SETUP_CONTAINER=istota-setup-web
# A re-run's rollback snapshot, under config/ and so uid 10001's: what Finish
# may change, put back by `istota setup --restore` when the run does not finish.
RERUN_SNAPSHOT=.setup-rerun
WATCHDOG_TIMER=istota-browser-watchdog.timer

# What setup --web's exit handler reads. setup_abort is armed while a re-run
# has stopped the stack and nothing new is installed.
setup_rerun=""
setup_abort=""
setup_server_pid=""
setup_watchdog_paused=""
STACK_ENV_BACKUP=""

# The watchdog runs every minute and is gated only on istota-stack.service
# being active, which it stays across a `compose stop`: it would start the
# browser again and send alerts during the run.
pause_watchdog() {
    command -v systemctl >/dev/null 2>&1 || return 0
    if systemctl is-active --quiet "$WATCHDOG_TIMER" 2>/dev/null; then
        systemctl stop "$WATCHDOG_TIMER"
        setup_watchdog_paused=1
    fi
}

# Only while enabled: a provision.sh run for a config without the browser
# disables it.
resume_watchdog() {
    [ -n "$setup_watchdog_paused" ] || return 0
    setup_watchdog_paused=""
    if systemctl is-enabled --quiet "$WATCHDOG_TIMER" 2>/dev/null; then
        systemctl start "$WATCHDOG_TIMER" || log "WARNING: could not start ${WATCHDOG_TIMER} again"
    fi
}

# As uid 10001, whose directory it is: root acts on nothing under config/.
drop_rerun_snapshot() {
    local drop=()
    if [ "$(id -u)" -eq 0 ]; then
        drop=(setpriv "--reuid=${ISTOTA_UID}" "--regid=${ISTOTA_UID}" --clear-groups --no-new-privs)
    fi
    ${drop[@]+"${drop[@]}"} rm -rf -- "${CONFIG_DIR}/${RERUN_SNAPSHOT}" \
        || log "WARNING: could not remove ${CONFIG_DIR}/${RERUN_SNAPSHOT}; remove it before the next \`istota-stack setup --web --force\`."
}

# A re-run that did not finish: the files Finish may have written go back
# from the snapshot, then the stack starts on them under the lock still held.
# A failed restore leaves the stack stopped. The caller's exit status stands.
put_previous_setup_back() {
    local up_rc f
    # A die inside install_setup_staging can leave a new .env beside the old
    # host.env; the backup is from before anything was minted.
    if [ -n "$STACK_ENV_BACKUP" ]; then
        for f in .env host.env rclone.conf; do
            if [ -f "${STACK_ENV_BACKUP}/${f}" ]; then
                cp -p "${STACK_ENV_BACKUP}/${f}" "${STACK}/${f}" \
                    || log "WARNING: could not put ${f} back from ${STACK_ENV_BACKUP}"
            fi
        done
    fi
    if ! ISTOTA_CONFIG_READ_ONLY=false oneshot -v "${SECRETS_DIR}:/vm/secrets" \
            "$(main_service)" istota setup --restore "/data/config/${RERUN_SNAPSHOT}" --vm-dir /vm; then
        log "the previous setup could not be put back (above). Its config and credentials are in ${CONFIG_DIR}/${RERUN_SNAPSHOT}${STACK_ENV_BACKUP:+, and .env, host.env and rclone.conf in ${STACK_ENV_BACKUP}}. The stack was not started."
        return 0
    fi
    log "the previous setup is back${STACK_ENV_BACKUP:+; .env, host.env and rclone.conf as they were are also in ${STACK_ENV_BACKUP}}."
    # set -e is ignored on the left of || and in an if, and cmd_up relies on it.
    set +e
    ( set -e; cmd_up )
    up_rc=$?
    set -e
    if [ "$up_rc" -eq 0 ]; then
        resume_watchdog
        log "the stack is starting on the previous setup."
    else
        log "the stack did not start (above); run \`istota-stack up\`."
    fi
}

# setup --web's one exit path, for a return, a die and a signal alike.
setup_web_exit() {
    local rc=$?
    # Ignored, not reset: a second Ctrl-C or a dropped session must not cut
    # the restore or the start short.
    trap - EXIT
    trap '' HUP INT TERM PIPE
    if [ -n "$setup_server_pid" ] || [ -n "$setup_abort" ]; then
        docker rm -f "$SETUP_CONTAINER" >/dev/null 2>&1 || true
    fi
    if [ -n "$setup_server_pid" ]; then
        wait "$setup_server_pid" 2>/dev/null || true
    fi
    if [ -n "$setup_abort" ]; then
        put_previous_setup_back
    fi
    if [ -n "$setup_watchdog_paused" ]; then
        log "the browser watchdog is paused: \`systemctl start ${WATCHDOG_TIMER}\` once the stack runs again."
    fi
    rm -rf "${staging:-}" "$SETUP_DIR"
    exit "$rc"
}

setup_web_signal() {
    trap '' HUP INT TERM PIPE
    log "setup --web was interrupted."
    exit "$1"
}

# The setup lock is what `setup-code` asks, so its question never touches the
# stack lock, which every writing verb takes; which setup runs is the stack
# lock's to decide, so `take` waits rather than refusing: the only other
# holder can be a `held` probe, for an instant.
# flock(2) through python3, since the lock outlives the call: `take` locks
# descriptor 8, which this shell opened and its children inherit, and a flock
# belongs to the open file, so it is held until this shell exits. `held` asks,
# from another process, whether someone holds it.
SETUP_LOCK_PY='
import fcntl, os, sys
mode, path = sys.argv[1], sys.argv[2]
if mode == "take":
    fd = 8
else:
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        sys.exit(1)
try:
    fcntl.flock(fd, fcntl.LOCK_EX if mode == "take" else fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    sys.exit(0)
if mode == "held":
    sys.exit(1)
# A run that finished between the open and the lock removed the file it held.
try:
    same = os.path.samestat(os.fstat(fd), os.stat(path, follow_symlinks=False))
except FileNotFoundError:
    same = False
sys.exit(0 if same else 1)
'

setup_lock() {
    python3 -I -c "$SETUP_LOCK_PY" "$1" "${SETUP_DIR}/lock"
}

route_source() {
    awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

# The address of this machine's route to the internet: IPv4, or IPv6 on a
# machine with no IPv4 route. Empty when it has neither.
primary_address() {
    local addr=""
    addr="$(ip -4 route get 1.1.1.1 2>/dev/null | route_source)" || addr=""
    if [ -z "$addr" ]; then
        addr="$(ip -6 route get 2606:4700:4700::1111 2>/dev/null | route_source)" || addr=""
    fi
    printf '%s' "$addr"
}

# The setup code, the certificate (not with --local) and the instructions, in
# .setup/, which is root's. Sixteen random bytes, of which the first 100 bits
# are written as four groups of five Crockford base32 characters, read off a
# console and typed. In a subshell for the umask: every file here is 0600.
#
# A re-run in direct ingress has served its domain with a year of HSTS
# (docker/nginx/listen-direct.conf), where a browser will not let anyone past a
# self-signed certificate: it uses the ACME certificate when there is one, and
# otherwise leaves the domain out.
mint_setup_files() (
    umask 077
    local publish="$1" local_mode="$2" rerun="${3:-}" code port suffix addr domain names fingerprint urls=() url
    local trusted="" left_out="" live
    python3 -I -c '
import secrets
alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
n = int.from_bytes(secrets.token_bytes(16), "big") >> 28
chars = "".join(alphabet[(n >> (5 * i)) & 31] for i in range(20))
print("-".join(chars[i:i + 5] for i in range(0, 20, 5)))
' > "${SETUP_DIR}/code"
    code="$(cat "${SETUP_DIR}/code")"
    port="${publish##*:}"
    if [ -n "$local_mode" ]; then
        suffix=":${port}"
        if [ "$port" = 80 ]; then suffix=""; fi
        urls=("http://localhost${suffix}/istota/setup#code=${code}")
    else
        suffix=":${port}"
        if [ "$port" = 443 ]; then suffix=""; fi
        addr="$(primary_address)"
        domain="$(env_get "$HOST_ENV" DOMAIN)"
        domain="${domain%%:*}"
        if [ -n "$rerun" ] && [ -n "$domain" ] && [ "$(env_get "$HOST_ENV" INGRESS)" = direct ]; then
            live="${STACK}/letsencrypt/live/${domain}"
            if [ -s "${live}/fullchain.pem" ] && [ -s "${live}/privkey.pem" ]; then
                cat "${live}/fullchain.pem" > "${SETUP_DIR}/cert.pem"
                cat "${live}/privkey.pem" > "${SETUP_DIR}/key.pem"
                trusted=1
                urls=("https://${domain}${suffix}/istota/setup#code=${code}")
            else
                left_out="$domain"
                domain=""
            fi
        fi
        if [ -z "$trusted" ]; then
            names=""
            if [ -n "$addr" ]; then
                names="IP:${addr}"
                case "$addr" in
                    *:*) urls+=("https://[${addr}]${suffix}/istota/setup#code=${code}") ;;
                    *) urls+=("https://${addr}${suffix}/istota/setup#code=${code}") ;;
                esac
            fi
            if [ -n "$domain" ]; then
                names="${names:+${names},}DNS:${domain}"
                urls+=("https://${domain}${suffix}/istota/setup#code=${code}")
            fi
            if [ "${#urls[@]}" -eq 0 ]; then
                urls=("https://<this server's address>${suffix}/istota/setup#code=${code}")
            fi
            openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -days 2 -nodes \
                -subj /CN=istota-setup -addext "subjectAltName=${names:-DNS:istota-setup}" \
                -keyout "${SETUP_DIR}/key.pem" -out "${SETUP_DIR}/cert.pem" 2>/dev/null
            fingerprint="$(openssl x509 -in "${SETUP_DIR}/cert.pem" -noout -fingerprint -sha256 | cut -d= -f2)"
        fi
    fi
    {
        echo "Open this address in your browser to set up Istota:"
        echo
        for url in "${urls[@]}"; do echo "  ${url}"; done
        echo
        if [ -n "$left_out" ]; then
            echo "${left_out} is left out: it has no certificate here, and browsers that"
            echo "have visited it refuse a self-signed one there."
            echo
        fi
        if [ -z "$local_mode" ] && [ -z "$trusted" ]; then
            echo "Your browser will warn that the connection is not private. That is expected"
            echo "for setup. Before you continue, check that the certificate's SHA-256"
            echo "fingerprint is:"
            echo
            echo "  ${fingerprint}"
            echo
            echo "The address above is this machine's own. If your provider gives it a"
            echo "different public address, open that one instead; the code still works."
            echo
        fi
        echo "Setup code (if you open the page some other way): ${code}"
    } > "${SETUP_DIR}/instructions"
)

# The setup server stopped without writing setup-done, so nothing was
# installed. Says why, names what it wrote in the config directory, and exits
# with its code. A re-run's exit handler puts the previous setup back instead.
setup_did_not_finish() {
    local rc="$1" path
    if [ -n "$setup_rerun" ]; then
        case "$rc" in
            3) log "setup timed out after an hour without a request." ;;
            4) log "setup stopped after too many wrong setup codes." ;;
            *) log "setup did not finish." ;;
        esac
        log "Nothing new was installed; the previous setup is put back. Run \`istota-stack setup --web --force\` again to change it."
        if [ "$rc" -eq 0 ]; then rc=1; fi
        exit "$rc"
    fi
    if [ "$rc" -eq 3 ]; then
        log "setup timed out after an hour without a request; nothing was installed on the host. Run \`istota-stack setup --web\` again."
    elif [ "$rc" -eq 4 ]; then
        log "setup stopped after too many wrong setup codes; nothing was installed on the host. Run \`istota-stack setup --web\` again for a new code."
    else
        log "setup did not finish; nothing was installed on the host."
        log "If the error above says the port is already in use, run it again with ISTOTA_SETUP_PUBLISH set to a free one (0.0.0.0:8443, for example)."
    fi
    # A Finish that failed partway may have written config and credentials.
    while IFS= read -r path; do
        log "the setup server wrote ${path} before it stopped: remove it before setting up again."
    done < <(find -P "$CONFIG_DIR" "$SECRETS_DIR" -maxdepth 1 ! -type d -newer "${SETUP_DIR}/code" 2>/dev/null)
    if [ "$rc" -eq 0 ]; then rc=1; fi
    exit "$rc"
}

# A rebuild for what the new config needs and the tag's images lack: Claude
# Code, which only a build of every image adds, or the images of a profile the
# setup turned on (the browser), built alone. On the desktop app the images
# came from the release's archive, and a build would fetch them all again:
# what they lack is the local layers, and a layer that fails (no network) is
# reported and left to `local-layers`, with the stack on the release's image.
build_what_setup_needs() {
    local tag="$1" lacking missing
    lacking="$(image_lacks_what_config_needs "$tag")"
    missing="$(missing_service_images "$tag")"
    if desktop_app; then
        [ -n "$lacking$missing" ] || return 0
        log "${lacking:-the setup turned on what the release left out}: building the local layers for ${tag}"
        run_local_layers "$tag" \
            || log "WARNING: a local layer did not build; \`istota-stack local-layers --status\` says why, and \`istota-stack local-layers\` tries again."
        return 0
    fi
    if [ -n "$lacking" ]; then
        log "${lacking}: building ${tag} again"
        if ! build_images "$tag" || ! build_devbox_images "$tag"; then
            die "building ${tag} failed. The config is in place; \`istota-stack update ${tag}\` builds it again."
        fi
        return 0
    fi
    [ -n "$missing" ] || return 0
    log "building $(echo "$missing" | tr '\n' ' ')for ${tag}: the setup turned on what its first build left out"
    # shellcheck disable=SC2086
    if ! WITHOUT_DEVBOX=1 ISTOTA_TAG="$tag" compose build $missing; then
        die "building $(echo "$missing" | tr '\n' ' ')for ${tag} failed. The config is in place; \`istota-stack update ${tag}\` builds it again."
    fi
}

# `setup --web [--force] [--local]`: cmd_setup with the setup server in the
# middle, and the steps cmd_setup leaves to the operator done after it. Never
# returns.
#
# With --force, over a configured stack: the root-owned env files are backed
# up, config/ and secrets/ are snapshotted by uid 10001, the watchdog is
# paused and the stack stopped (under the lock this holds, so nothing waits on
# it), and only then is the code minted, so the address cannot reach the
# running app. Until the staged files are installed, any exit puts the
# snapshot back and starts the stack again; after that the run is committed.
cmd_setup_web() {
    local local_mode="" arg tag publish forward inner rc=0 local_arg=() force_arg=()
    for arg in "$@"; do
        case "$arg" in
            --web) ;;
            --local) local_mode=1 ;;
            --force) setup_rerun=1; force_arg=(--force) ;;
            *) usage >&2; exit 64 ;;
        esac
    done
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    [ -n "$tag" ] || die "no image yet: run \`istota-stack update <tag>\` first."
    if [ -z "$setup_rerun" ]; then
        refuse_if_set_up
    elif [ ! -e "${CONFIG_DIR}/config.toml" ]; then
        die "nothing to change: there is no ${CONFIG_DIR}/config.toml. Set istota up with \`istota-stack setup --web\`."
    fi
    if [ -n "$local_mode" ]; then
        # The port Lima forwards, which the Mac writes; the page must answer there.
        forward="$(env_get "$HOST_ENV" LOCAL_FORWARD_PORT)"
        case "$forward" in ""|0*|*[!0-9]*) forward=8080 ;; esac
        publish="${ISTOTA_SETUP_PUBLISH:-127.0.0.1:${forward}}"
        inner=8080
        local_arg=(--local)
    else
        # An IPv4 publish does not listen on IPv6, and the printed address is
        # IPv6 on a machine with no IPv4 route.
        case "$(primary_address)" in
            *:*) publish="${ISTOTA_SETUP_PUBLISH:-[::]:443}" ;;
            *) publish="${ISTOTA_SETUP_PUBLISH:-0.0.0.0:443}" ;;
        esac
        inner=8443
    fi
    [[ "$publish" =~ ^(\[[0-9A-Fa-f:]+\]|[0-9.]+):[0-9]+$ ]] \
        || die "ISTOTA_SETUP_PUBLISH is an address and a port (0.0.0.0:443, [::]:443), not '${publish}'."

    install -d -m 0700 "$SETUP_DIR"
    exec 8>>"${SETUP_DIR}/lock"
    setup_lock take || die "could not take ${SETUP_DIR}/lock; nothing was done."
    trap setup_web_exit EXIT
    trap 'setup_web_signal 129' HUP
    trap 'setup_web_signal 130' INT
    trap 'setup_web_signal 143' TERM
    trap 'setup_web_signal 141' PIPE
    rm -f "${SETUP_DIR}/code" "${SETUP_DIR}/cert.pem" "${SETUP_DIR}/key.pem" "${SETUP_DIR}/instructions"

    prepare_setup
    if [ -z "$setup_rerun" ]; then
        refuse_if_set_up
    else
        backup_stack_env
        ISTOTA_CONFIG_READ_ONLY=false oneshot -v "${SECRETS_DIR}:/vm/secrets" \
            "$(main_service)" istota setup --snapshot "/data/config/${RERUN_SNAPSHOT}" --vm-dir /vm \
            || die "the setup files could not be copied aside (above); nothing was changed."
        setup_abort=1
        pause_watchdog
        log "stopping the stack for the setup; it starts again when the setup finishes or is abandoned"
        compose stop
    fi
    # A container left by a run that died outright would hold the name.
    docker rm -f "$SETUP_CONTAINER" >/dev/null 2>&1 || true
    mint_setup_files "$publish" "$local_mode" "$setup_rerun"
    new_staging
    install -m 0400 "${SETUP_DIR}/code" "${staging}/setup-code"
    if [ -z "$local_mode" ]; then
        install -m 0400 "${SETUP_DIR}/cert.pem" "${staging}/cert.pem"
        install -m 0400 "${SETUP_DIR}/key.pem" "${staging}/key.pem"
    fi
    chown -R "$ISTOTA_UID:$ISTOTA_UID" "$staging"
    cat "${SETUP_DIR}/instructions"

    # In the background, then `wait`: bash runs a trap only between foreground
    # commands, so a signal would otherwise wait for the server, up to an idle
    # hour, while it still held the port and the lock.
    ISTOTA_CONFIG_READ_ONLY=false oneshot --name "$SETUP_CONTAINER" -p "${publish}:${inner}" \
        -e ISTOTA_SECRETS_DIR=/nonexistent \
        -v "${staging}:/vm" -v "${SECRETS_DIR}:/vm/secrets" \
        "$(main_service)" istota setup --web "${force_arg[@]}" --vm-dir /vm "${local_arg[@]}" &
    setup_server_pid=$!
    wait "$setup_server_pid" || rc=$?
    setup_server_pid=""
    # Nothing running as 10001 may change staging while root reads it.
    chown root:root "$staging"
    chmod 0700 "$staging"
    if [ ! -f "${staging}/setup-done" ] || [ -L "${staging}/setup-done" ]; then
        setup_did_not_finish "$rc"
    fi

    install_setup_staging "$staging"
    # The wizard owns .env's keys but not this script's.
    env_set "ISTOTA_TAG=${tag}"
    if [ -n "$setup_rerun" ]; then
        # Committed: .env and host.env now go with the new config, so a later
        # failure leaves the stack stopped rather than putting anything back.
        setup_abort=""
        drop_rerun_snapshot
    fi
    render_devbox_compose "$tag"
    build_what_setup_needs "$tag"
    copy_stack_env_out
    if [ -n "$setup_rerun" ]; then
        # The unit stays active across `compose stop`, so the stack starts
        # with `up` under the lock rather than through systemd, whose ExecStop
        # and ExecStart take it. provision.sh runs `istota-stack up` itself.
        if provision_outdated; then
            log "host.env changed what this host provisions; running ${SRC}/host/provision.sh"
            release_stack_lock
            "${SRC}/host/provision.sh" \
                || die "provision.sh failed. The config is in place: fix it, run ${SRC}/host/provision.sh, then \`istota-stack up\`."
            take_stack_lock "setup --web"
        fi
        cmd_up
        resume_watchdog
        log "changed, and the stack is starting. The setup page goes to the sign-in page once it answers."
        exit 0
    fi
    # Both steps below start `istota-stack up`: provision.sh directly, and the
    # unit's ExecStart in a process systemd starts. That `up` opens the lock
    # afresh, so either would wait on the one this process holds. The setup
    # lock stays held, so `setup-code` still answers until this exits.
    release_stack_lock
    # A first setup choosing direct ingress or Nextcloud changes what is
    # provisioned. Run as a child, not exec'd as an update does it, because the
    # start comes after it.
    if provision_outdated; then
        log "host.env changed what this host provisions; running ${SRC}/host/provision.sh"
        "${SRC}/host/provision.sh" \
            || die "provision.sh failed. The config is in place: fix it, run ${SRC}/host/provision.sh, then \`systemctl enable --now istota-stack\`."
    fi
    systemctl enable --now istota-stack
    log "set up, and the stack is starting. The setup page goes to the sign-in page once it answers."
    # Exit rather than return: provision.sh may have replaced this script's
    # file, and bash reads the rest of a script from the file as it goes. The
    # EXIT trap removes staging and .setup/.
    exit 0
}

# Ends a `setup --web` in progress by removing its server's container; that
# run then sees the server gone, and a re-run puts the previous setup back and
# starts the stack. No lock: the run being cancelled holds it.
cmd_setup_cancel() {
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    docker container inspect "$SETUP_CONTAINER" >/dev/null 2>&1 \
        || die "no browser setup is running (there is no ${SETUP_CONTAINER} container)."
    docker rm -f "$SETUP_CONTAINER" >/dev/null || die "could not remove the ${SETUP_CONTAINER} container (above)."
    log "stopped the browser setup. A re-run puts the previous setup back and starts the stack again."
}

cmd_setup_code() {
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    if [ ! -d "$SETUP_DIR" ] || ! setup_lock held; then
        die "no setup in progress. \`istota-stack setup --web\` starts one."
    fi
    if [ ! -s "${SETUP_DIR}/instructions" ]; then
        die "a setup is starting; run this again in a moment."
    fi
    cat "${SETUP_DIR}/instructions"
}

# `istota apply` a plan in a one-shot container with the config directory open,
# the plan's directory bound read-only at /plan, where uid 10001 must be able
# to read it. The caller decides about a restart. Exit codes are istota
# apply's: 0 nothing changed, 2 changed (or would, under --dry-run), 1 refused.
#
# `--secrets-file <file>` as the second and third arguments binds that file's
# directory read-only at /secrets and passes its path in the container: a
# credential sidecar travels as a file, never on argv or the plan's stdin.
apply_plan_file() {
    local plan="$1" binds=() secrets=()
    shift
    binds=(-v "$(dirname "$plan"):/plan:ro")
    if [ "${1:-}" = --secrets-file ]; then
        binds+=(-v "$(dirname "$2"):/secrets:ro")
        secrets=(--secrets-file "/secrets/$(basename "$2")")
        shift 2
    fi
    ISTOTA_CONFIG_READ_ONLY=false oneshot "${binds[@]}" \
        "$(main_service)" istota apply -f "/plan/$(basename "$plan")" ${secrets[@]+"${secrets[@]}"} "$@"
}

# Refuse a credential-bearing input unless it is a regular file, not a link,
# with no group or other permission bits: the rule `istota apply` holds a
# sidecar to, checked here because the staged copy is always 0400.
require_private_file() {
    local path="$1" what="$2"
    if [ -z "$(find -P "$path" -maxdepth 0 -type f ! -perm -0001 ! -perm -0002 ! -perm -0004 \
            ! -perm -0010 ! -perm -0020 ! -perm -0040 2>/dev/null)" ]; then
        die "${what} must be a private regular file (mode 0600), not a link: ${path}"
    fi
}

# Reads `istota apply --format json`'s result document (the last line of its
# stdout) and prints it, then `dry_run changed partial restart_required` as
# 0/1 words on the next line. Exit 1 when there is no well-formed document.
APPLY_RESULT_PY='
import json, sys
try:
    with open(sys.argv[1], "rb") as fh:
        lines = [line for line in fh.read(1 << 24).decode().splitlines() if line.strip()]
    document = json.loads(lines[-1])
except (OSError, ValueError, IndexError):
    sys.exit(1)
flags = ("dry_run", "changed", "partial", "restart_required")
if not isinstance(document, dict) or document.get("version") != 1 \
        or any(type(document.get(flag)) is not bool for flag in flags):
    sys.exit(1)
print(lines[-1])
print(" ".join("1" if document[flag] else "0" for flag in flags))
'

# `istota apply` a plan from this host, and restart the stack at most once,
# when the result says a committed change needs it. stdout is the apply's JSON
# result document and nothing else (the management role reads it); this
# script's own messages go to stderr. A partial apply restarts nothing: what
# was committed stays, and the operator completes it and restarts.
#
# --no-restart records a needed restart in RESTART_OWED instead of taking it,
# and the next apply without the flag takes it along with its own, once. The
# management role passes it to its config apply when a user settings apply
# follows (ISSUE-741). A file, so a play that fails between the two leaves the
# restart to the next apply rather than losing it.
cmd_apply() {
    [ "$#" -ge 1 ] || { usage >&2; exit 64; }
    local plan="$1" name rc=0 sidecar="" check="" role="" args=() secrets=() decision="" document=""
    local defer="" restarted=""
    shift
    [ -f "$plan" ] || die "no plan at ${plan}"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --secrets-file)
                [ "$#" -ge 2 ] || { usage >&2; exit 64; }
                sidecar="$2"; shift 2; continue ;;
            --secrets-file=*) sidecar="${1#*=}" ;;
            --format|--format=*)
                local format="${1#--format}"
                if [ -z "$format" ]; then
                    [ "$#" -ge 2 ] || { usage >&2; exit 64; }
                    format="$2"; shift
                fi
                [ "${format#=}" = json ] || { echo "[istota-stack] apply prints istota apply's JSON result; --format ${format#=} is not available here" >&2; exit 64; } ;;
            --input-format)
                [ "$#" -ge 2 ] || { usage >&2; exit 64; }
                [ "$2" != role-vars ] || role=1
                args+=("$1" "$2"); shift 2; continue ;;
            --input-format=role-vars) role=1; args+=("$1") ;;
            --check) check=1; args+=("$1") ;;
            --no-restart) defer=1 ;;
            *) args+=("$1") ;;
        esac
        shift
    done
    # Role variables carry credentials, so they meet the sidecar's file rule.
    if [ -n "$role" ]; then require_private_file "$plan" "a role-vars input"; fi
    if [ -n "$sidecar" ]; then require_private_file "$sidecar" "--secrets-file"; fi
    staging="$(mktemp -d)"
    trap 'rm -rf "${staging:-}"' EXIT
    chmod 0700 "$staging"
    name="$(basename "$plan")"
    # Readable by uid 10001 alone: a plan can hold credentials. Each input has
    # a directory of its own, so a plan and a sidecar of the same name both
    # keep their names, and with them the suffix that says JSON or TOML.
    install -d -m 0700 "${staging}/plan"
    install -m 0400 "$plan" "${staging}/plan/${name}"
    if [ -n "$sidecar" ]; then
        install -d -m 0700 "${staging}/secrets"
        install -m 0400 "$sidecar" "${staging}/secrets/$(basename "$sidecar")"
        secrets=(--secrets-file "${staging}/secrets/$(basename "$sidecar")")
    fi
    if [ "$(id -u)" -eq 0 ]; then
        chown -R "$ISTOTA_UID:$ISTOTA_UID" "${staging}/plan"
        if [ -n "$sidecar" ]; then chown -R "$ISTOTA_UID:$ISTOTA_UID" "${staging}/secrets"; fi
    fi

    if [ -n "$check" ]; then
        # --check validates the plan alone: no result document, no restart.
        apply_plan_file "${staging}/plan/${name}" ${secrets[@]+"${secrets[@]}"} ${args[@]+"${args[@]}"} || rc=$?
        return "$rc"
    fi
    # The result goes to a root-only file beside the bound directories, never
    # into one uid 10001 could change before root reads it.
    apply_plan_file "${staging}/plan/${name}" ${secrets[@]+"${secrets[@]}"} ${args[@]+"${args[@]}"} \
        --format json > "${staging}/result" || rc=$?
    if ! decision="$(python3 -I -c "$APPLY_RESULT_PY" "${staging}/result")"; then
        { copy_stack_env_out; } >&2
        echo "[istota-stack] istota apply exited ${rc} without a result document; nothing was restarted. An image older than this istota-stack reports none: update the stack first." >&2
        return 1
    fi
    document="${decision%$'\n'*}"
    decision="${decision##*$'\n'}"
    printf '%s\n' "$document"
    {
        copy_stack_env_out
        # dry_run changed partial restart_required
        case "${rc}:${decision}" in
            1:*" 1 "?)
                log "partially applied: the operations the result lists as applied are in place and the rest are not; nothing was restarted."
                if [ "${decision##* }" = 1 ]; then
                    log "the applied changes need a restart: fix the error and apply the plan again, then restart the stack (\`systemctl restart istota-stack\`)."
                else
                    log "fix the error and apply the plan again to complete it."
                fi ;;
            1:*) log "the plan was refused or failed before any change was applied; nothing was restarted." ;;
            2:"1 1 0 "?) log "dry run: nothing was written." ;;
            2:"0 1 0 1")
                if [ -n "$defer" ] && [ -z "$(compose ps -q "$(main_service)" 2>/dev/null)" ]; then
                    # A stopped stack reads the config when it starts: nothing is owed.
                    restart_for_config
                elif [ -n "$defer" ]; then
                    touch "$RESTART_OWED"
                    log "the changes need a restart; with --no-restart it is left to the next \`istota-stack apply\`."
                else
                    restart_for_config
                    restarted=1
                fi ;;
            2:"0 1 0 0") log "the changes are read without a restart; nothing was restarted." ;;
            0:?" 0 0 "?) ;;
            *) log "istota apply's exit ${rc} does not match its result (${decision}); nothing was restarted."
               rc=1
               decision="" ;;
        esac
        # What an earlier --no-restart apply committed and left owed. Not on a
        # dry run, a partial apply or a result that contradicts its exit.
        if [ -z "$defer" ] && [ -z "$restarted" ] && [ -e "$RESTART_OWED" ]; then
            case "${rc}:${decision}" in
                1:*" 1 "?) log "an earlier apply's changes also need a restart, which is still owed." ;;
                ?:"0 "*)
                    log "an earlier apply's changes need a restart."
                    restart_for_config ;;
            esac
        fi
    } >&2
    return "$rc"
}

# `istota migrate import-bare-metal` in a one-shot container, with the unpacked
# export read-only at /import and the secrets directory writable at /secrets.
# The import replaces the database and the master key, and the daemon's own
# lock is in a /tmp the one-shot does not share, so the refusal is here: no
# container of the stack may be running.
cmd_import_bare_metal() {
    [ "$#" -ge 1 ] || { usage >&2; exit 64; }
    local source="$1" running
    shift
    [ -d "$source" ] || die "no unpacked export at ${source}"
    running="$(compose ps -q)" || die "could not ask docker compose whether the stack is running; nothing was imported."
    if [ -n "$running" ]; then
        die "the stack is running. Stop it first (\`systemctl stop istota-stack\`); the import replaces its database and master key."
    fi
    ISTOTA_CONFIG_READ_ONLY=false oneshot \
        -v "${source}:/import:ro" -v "${SECRETS_DIR}:/secrets" \
        "$(main_service)" istota migrate import-bare-metal --source /import "$@"
}

# `istota migrate restore-workspace` in a one-shot container: the master key
# from stdin into /data/.secret_key, config.toml and admins from the
# workspace's Backups/config/, the databases from its snapshots. The local
# VM's recovery (the Mac's `istota-stack restore`, after `create --no-setup`).
# The module refuses whatever it would replace that differs; the stack has to
# be down, as for import-bare-metal, since the daemon's lock is in a /tmp the
# one-shot does not share.
#
# The module hands back the stack's .env and host.env copies (stack.env,
# host.env, copied in by copy_stack_env_out) in a staging directory, as setup's
# wizard does; they go in place here, except .env's tag lines, which name the
# old VM's images and stay this VM's, as host.env's ISTOTA_DESKTOP_APP does. Then what the restored config and
# profiles need is built and the host provisioned; the caller starts the stack.
cmd_restore() {
    local running owner=() tag rc=0 key saved=() desktop
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    desktop="$(env_get "$HOST_ENV" ISTOTA_DESKTOP_APP)"
    [ -n "$tag" ] || die "no image yet: run \`istota-stack update <tag>\` first."
    running="$(compose ps -q)" || die "could not ask docker compose whether the stack is running; nothing was restored."
    if [ -n "$running" ]; then
        die "the stack is running. Stop it first (\`systemctl stop istota-stack\`); a restore replaces its database."
    fi
    # Compose would make a missing bind source root's.
    if [ "$(id -u)" -eq 0 ]; then owner=(-o "$ISTOTA_UID" -g "$ISTOTA_UID"); fi
    install -d -m 0750 ${owner[@]+"${owner[@]}"} "$CONFIG_DIR"
    trap 'rm -rf "${staging:-}"' EXIT
    staging="$(mktemp -d "${STACK}/.restore.XXXXXX")"
    if [ "$(id -u)" -eq 0 ]; then chown "$ISTOTA_UID:$ISTOTA_UID" "$staging"; fi
    ISTOTA_CONFIG_READ_ONLY=false oneshot -v "${staging}:/vm" \
        "$(main_service)" istota migrate restore-workspace --vm-dir /vm "$@" || rc=$?
    # 1 is a refusal with nothing written; 2 is partial, with the config in place.
    [ "$rc" -eq 0 ] || [ "$rc" -eq 2 ] || exit "$rc"
    # Nothing running as 10001 may change staging while root reads it.
    if [ "$(id -u)" -eq 0 ]; then chown root:root "$staging"; fi
    chmod 0700 "$staging"

    if [ -e "${staging}/stack.env" ] || [ -L "${staging}/stack.env" ]; then
        for key in ISTOTA_TAG ISTOTA_TAG_UNSIGNED ISTOTA_PREVIOUS_TAG ISTOTA_PREVIOUS_TAG_UNSIGNED; do
            saved+=("${key}=$(env_get "$ENV_FILE" "$key")")
        done
        install_staged "${staging}/stack.env" "$ENV_FILE"
        env_set "${saved[@]}"
        log "restored .env from the workspace, keeping this VM's tag (${tag})"
    fi
    if [ -e "${staging}/host.env" ] || [ -L "${staging}/host.env" ]; then
        install_staged "${staging}/host.env" "$HOST_ENV"
        # Like the tag: this VM's images came from a release archive, whatever
        # the backed-up install's did.
        [ "$desktop" != 1 ] || file_set "$HOST_ENV" ISTOTA_DESKTOP_APP=1
        log "restored host.env from the workspace"
    fi
    render_devbox_compose "$tag"
    build_what_setup_needs "$tag"
    if provision_outdated; then
        log "host.env changed what this host provisions; running ${SRC}/host/provision.sh"
        # provision.sh may start istota-stack.service, whose `up` would wait
        # on the lock this process holds.
        release_stack_lock
        "${SRC}/host/provision.sh" \
            || die "provision.sh failed. The restore is in place: fix it, run ${SRC}/host/provision.sh, then \`systemctl enable --now istota-stack\`."
    fi
    # Exit rather than return: provision.sh may have replaced this script's file.
    exit "$rc"
}

# `istota migrate import-standalone` in a one-shot container: a standalone
# install the Mac's istota-stack staged in <dir> (read-only at /import), its
# istota.env on stdin, onto a stack made with `create --no-setup`. The module
# writes config.toml, admins, the master key and the secrets files, restores
# the databases, and stages .env and host.env as setup's wizard does; they go
# in place here, then what the config needs is built and the host provisioned,
# as after setup. The caller starts the stack. Down, as for restore: the
# import replaces the database and the master key.
cmd_import_standalone() {
    [ "$#" -ge 1 ] || { usage >&2; exit 64; }
    local source="$1" tag running rc=0 dry=""
    shift
    case " $* " in *" --dry-run "*) dry=1 ;; esac
    [ -d "$source" ] || die "no staged standalone install at ${source}"
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    [ -n "$tag" ] || die "no image yet: run \`istota-stack update <tag>\` first."
    running="$(compose ps -q)" || die "could not ask docker compose whether the stack is running; nothing was imported."
    if [ -n "$running" ]; then
        die "the stack is running. Stop it first (\`systemctl stop istota-stack\`); the import replaces its database and master key."
    fi
    prepare_setup
    trap 'rm -rf "${staging:-}"' EXIT
    new_staging
    if [ "$(id -u)" -eq 0 ]; then chown -R "$ISTOTA_UID:$ISTOTA_UID" "$staging"; fi
    ISTOTA_CONFIG_READ_ONLY=false oneshot \
        -v "${source}:/import:ro" -v "${staging}:/vm" -v "${SECRETS_DIR}:/vm/secrets" \
        "$(main_service)" istota migrate import-standalone --source /import --vm-dir /vm "$@" || rc=$?
    # 1 is a refusal with nothing written; 2 a partial, which a re-run resumes.
    [ "$rc" -eq 0 ] || exit "$rc"
    [ -z "$dry" ] || exit 0
    # Nothing running as 10001 may change staging while root reads it.
    if [ "$(id -u)" -eq 0 ]; then chown root:root "$staging"; fi
    chmod 0700 "$staging"
    install_setup_staging "$staging"
    env_set "ISTOTA_TAG=${tag}"
    render_devbox_compose "$tag"
    build_what_setup_needs "$tag"
    copy_stack_env_out
    if provision_outdated; then
        log "host.env changed what this host provisions; running ${SRC}/host/provision.sh"
        # As in restore: provision.sh may start the unit, whose `up` takes the lock.
        release_stack_lock
        "${SRC}/host/provision.sh" \
            || die "provision.sh failed. The import is in place: fix it, run ${SRC}/host/provision.sh, then \`systemctl enable --now istota-stack\`."
    fi
    # Exit rather than return: provision.sh may have replaced this script's file.
    exit 0
}

# The stack's .env and host.env into the workspace's Backups/config/<UTC
# date>/, beside the config.toml and admins db_backup copies there, so a lost
# VM's restore can put them back. Neither holds a credential, which
# tests/test_workspace_restore.py holds against what setup writes. Only where
# the workspace is a mount, db_backup's rule: the rclone mount, or a host folder
# with its marker. Run as uid 10001, whose the workspace is, through directory
# fds that follow no link. Best-effort: a failure is a warning, never the
# calling verb's. Called by update, setup and apply. Nothing is copied before
# setup has written config.toml: the Mac's restore runs update on a new VM,
# whose bare .env and host.env would replace the day's set it is about to read.
COPY_STACK_ENV_PY='
import os, sys
root, date, pairs = sys.argv[1], sys.argv[2], sys.argv[3:]
dir_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
fd = os.open(root, dir_flags)
try:
    for part in ("Backups", "config", date):
        try:
            os.mkdir(part, 0o700, dir_fd=fd)
        except FileExistsError:
            pass
        inner = os.open(part, dir_flags, dir_fd=fd)
        os.close(fd)
        fd = inner
    for pair in pairs:
        name, source = pair.split("=", 1)
        try:
            src = os.open(source, os.O_RDONLY | os.O_NOFOLLOW)
        except FileNotFoundError:
            continue
        with os.fdopen(src, "rb") as fh:
            data = fh.read(1 << 20)
        tmp = f".{name}.{os.getpid()}"
        out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd)
        with os.fdopen(out, "wb") as fh:
            fh.write(data)
            os.fchmod(fh.fileno(), 0o600)
        os.replace(tmp, name, src_dir_fd=fd, dst_dir_fd=fd)
finally:
    os.close(fd)
'

copy_stack_env_out() {
    local storage day drop=()
    storage="$(env_get "$HOST_ENV" STORAGE)"
    case "$storage" in host-folder|nextcloud) ;; *) return 0 ;; esac
    [ -f "${CONFIG_DIR}/config.toml" ] || return 0
    mountpoint -q "$MOUNT_DIR" 2>/dev/null || return 0
    if [ "$storage" = host-folder ] \
            && { [ -L "${MOUNT_DIR}/.istota-workspace" ] || [ ! -f "${MOUNT_DIR}/.istota-workspace" ]; }; then
        return 0
    fi
    day="$(date -u +%F)"
    if [ "$(id -u)" -eq 0 ]; then
        drop=(setpriv "--reuid=${ISTOTA_UID}" "--regid=${ISTOTA_UID}" --clear-groups --no-new-privs)
    fi
    ${drop[@]+"${drop[@]}"} python3 -I -c "$COPY_STACK_ENV_PY" "$MOUNT_DIR" "$day" \
            "stack.env=${ENV_FILE}" "host.env=${HOST_ENV}" 2>&1 \
        || log "WARNING: could not copy .env and host.env into ${MOUNT_DIR}/Backups/config/${day}; a restore from this workspace would not have them."
}

# After a config change: re-render the devbox services, since [devbox] users may
# have changed, and bring a running stack onto both. `up -d` creates an added
# user's devbox and recreates the daemon with its socket volumes; `restart` is what
# makes every other service read the new config.toml. A stack that is down
# stays down.
restart_for_config() {
    render_devbox_compose "$(env_get "$ENV_FILE" ISTOTA_TAG)" \
        || log "the devbox services were not re-rendered; run \`istota-stack update <tag>\`"
    if [ -z "$(compose ps -q "$(main_service)" 2>/dev/null)" ]; then
        log "the config changed; the stack is not running, so nothing was restarted"
        rm -f "$RESTART_OWED"
        return 0
    fi
    log "the config changed; restarting the stack"
    # Explicit returns: config-apply calls this on the left of `||`, where
    # set -e is off, and a failed restart must leave the owed one recorded.
    stack_up || return $?
    compose restart || return $?
    rm -f "$RESTART_OWED"
}

# --- moving the workspace off the mount ------------------------------------------

# Where the workspace lives inside the containers, before and after the move.
CONTAINER_MOUNT=/mnt/shared
LOCAL_WORKSPACE=/data/workspace
# What writes the workspace: the room-relocation set.
LOCALIZE_WRITERS="daemon web whatsapp-baileys"

# The offline move from the rclone mount to /data/workspace on the state volume
# (docs/deployment/moving-to-a-local-workspace.md). The copy, the config edit
# and the reindex are `istota workspace` verbs run as uid 10001, so root reads
# and writes nothing under config/ or the mount. A config `istota apply` wrote,
# and a destination the copy would refuse, are refused before anything stops;
# the plan would undo the edit, so that install moves by its plan, after a
# --copy-only run here. MOVED.md goes onto the mount only once the config no
# longer names it, and never under --copy-only.
cmd_localize_workspace() {
    local copy_only="" dry_run="" accept="" note=1 rc=0 pass=() resume=() service services stop=() answer=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --copy-only) copy_only=1 ;;
            --dry-run) dry_run=1; pass+=(--dry-run) ;;
            --resume) resume=(--resume); pass+=(--resume) ;;
            --no-note) note="" ;;
            --accept-skipped) accept=1 ;;
            *) usage >&2; exit 64 ;;
        esac
        shift
    done
    [ -f "${CONFIG_DIR}/config.toml" ] || die "no ${CONFIG_DIR}/config.toml: nothing to move."
    [ "$(env_get "$HOST_ENV" STORAGE)" = "nextcloud" ] \
        || die "host.env does not say STORAGE=nextcloud: the workspace is not the rclone mount, so there is nothing to move."
    if [ -z "$copy_only" ] && [ -z "$dry_run" ]; then
        oneshot "$(main_service)" istota workspace localize-config --check --workspace "$LOCAL_WORKSPACE" \
            || die "config.toml cannot be moved here (above); nothing was stopped. A config written by \`istota apply\` moves by its plan: run \`istota-stack localize-workspace --copy-only\`, then set istota_storage: local, workspace_path = \"${LOCAL_WORKSPACE}\", no workspace_mount_path and auto_share_bot_dir = false in the plan, and apply it."
    fi
    if [ -z "$dry_run" ]; then
        oneshot "$(main_service)" istota workspace localize --check \
            --from "$CONTAINER_MOUNT" --to "$LOCAL_WORKSPACE" "${resume[@]}" \
            || die "the copy cannot start (above); nothing was stopped."
        # Captured, not piped into `grep -q`: under pipefail an early match
        # closed the pipe and read as "no daemon" (ISSUE-736).
        services="$(compose config --services)" \
            || die "compose could not list the stack's services (above); nothing was stopped."
        for service in $LOCALIZE_WRITERS; do
            if grep -qxF -- "$service" <<<"$services"; then stop+=("$service"); fi
        done
        if [ "${#stop[@]}" -gt 0 ]; then
            log "stopping ${stop[*]}"
            compose stop "${stop[@]}"
        fi
        pass+=(--scheduler-stopped)
    fi
    oneshot "$(main_service)" istota workspace localize \
        --from "$CONTAINER_MOUNT" --to "$LOCAL_WORKSPACE" "${pass[@]}" || rc=$?
    if [ -n "$dry_run" ]; then
        return "$rc"
    fi
    case "$rc" in
        0) ;;
        2)
            if [ -n "$accept" ]; then
                log "the copy skipped entries (listed above); going on (--accept-skipped)"
            elif [ -t 0 ]; then
                printf '[istota-stack] The copy skipped the entries listed above. Move to the local workspace anyway? [y/N] '
                read -r answer || true
                case "$answer" in
                    y|Y|yes) ;;
                    *) die "stopped before the config change, with the stack down. \`istota-stack up\` returns to the mount." ;;
                esac
            else
                die "the copy skipped entries (listed above); stopped before the config change, with the stack down. Re-run with --resume --accept-skipped to go on, or \`istota-stack up\` to return to the mount."
            fi
            ;;
        *) die "the copy exited ${rc}; config.toml is unchanged and the stack is down. Re-run with --resume, or \`istota-stack up\` to return to the mount." ;;
    esac
    if [ -n "$copy_only" ]; then
        log "copied, and the stack is down. Change the plan (istota_storage: local, workspace_path = \"${LOCAL_WORKSPACE}\", no workspace_mount_path, auto_share_bot_dir = false) and apply it, then run \`istota-stack exec istota workspace reindex --forget-root ${CONTAINER_MOUNT}\`."
        return 0
    fi
    ISTOTA_CONFIG_READ_ONLY=false oneshot "$(main_service)" istota workspace localize-config --workspace "$LOCAL_WORKSPACE" \
        || die "the config change failed; the copy is in ${LOCAL_WORKSPACE} and the stack is down. \`istota-stack up\` returns to the mount."
    if [ -n "$note" ]; then
        oneshot "$(main_service)" istota workspace moved-note --from "$CONTAINER_MOUNT" \
            || log "WARNING: not every user got MOVED.md in their Nextcloud bot folder (above); the move goes on."
    fi
    file_set "$HOST_ENV" STORAGE=local
    log "host.env: STORAGE=local"
    if [ -x "${SRC}/host/provision.sh" ]; then
        # provision.sh may start istota-stack.service, whose `up` takes the lock.
        release_stack_lock
        "${SRC}/host/provision.sh" || die "provision.sh failed after the config change; run it again, then \`istota-stack up\`."
        take_stack_lock localize-workspace
    fi
    cmd_up
    stack_exec istota workspace reindex --forget-root "$CONTAINER_MOUNT" \
        || log "WARNING: the memory reindex failed; run \`istota-stack exec istota workspace reindex --forget-root ${CONTAINER_MOUNT}\` again."
    log "the workspace is now ${LOCAL_WORKSPACE}. To go back, follow \"Going back\" in docs/deployment/moving-to-a-local-workspace.md: it restores config/config.toml.pre-localize, removes the MOVED.md notes and the index rows under ${LOCAL_WORKSPACE}."
}

# Read-only: origin is asked, not fetched, so the checkout and its refs stay as
# they are. The management role compares this with ISTOTA_TAG, because an
# update rebuilds even when main has not moved.
cmd_latest_tag() {
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    [ -d "${SRC}/.git" ] || die "${SRC} is not a git checkout; provision.sh clones it."
    local commit
    commit="$(verified_git ls-remote --exit-code origin "refs/heads/${LATEST_BRANCH}" | cut -f1)" \
        || die "could not read ${LATEST_BRANCH} from origin."
    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "origin answered no commit for ${LATEST_BRANCH}."
    latest_name "$commit"
}

cmd_check_image() {
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    local tag lacking
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    [ -n "$tag" ] || { log "no tag deployed yet; nothing to check"; return 0; }
    lacking="$(image_lacks_what_config_needs "$tag")"
    if [ -n "$lacking" ]; then
        log "${lacking}: run \`$(image_remedy "$tag")\`."
        return 2
    fi
}

# The files in the stack that uid 10001 owns, written as 10001: secrets/ and
# config/admins. Root on the VM drops before anything is opened, so a link
# 10001 planted in either directory is followed, if at all, with 10001's own
# rights; the writer replaces a link rather than following it in any case.
#
# stdin is one JSON object: {"secrets": {name: value}, "admins": text}. A
# string value is written exactly (0400); null creates an empty file only where
# none exists, since compose refuses to start a service whose secret file is
# missing. "admins", when present, is the whole file (0600). Exit 0 when
# nothing changed, 2 when something did (or would, under --dry-run). Nothing
# printed names a value.
PUT_FILES_PY='
import datetime, json, os, re, stat, sys, tempfile

secrets_dir, config_dir, dry_run = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
request = json.load(sys.stdin)

# Who manages the secrets and the admins, for config/managed.json, in the
# format istota.apply.write_managed writes (the authoritative copy), restated
# here because this runs with no istota to import. Checked before anything is
# written.
claims = {}
managed = request.get("managed")
if managed is not None:
    if not isinstance(managed, dict):
        sys.exit("[istota-stack] REFUSE: managed is not an object")
    source = managed.get("source")
    if not isinstance(source, str) or len(source) > 64:
        sys.exit("[istota-stack] REFUSE: managed.source is not a string of at most 64 characters")
    for key, value in managed.items():
        if key == "source":
            continue
        if key not in ("secrets", "admins") or not isinstance(value, bool):
            sys.exit(f"[istota-stack] REFUSE: managed.{key} is not secrets or admins set to true or false")
        claims[key] = value

wanted = []
for name, value in (request.get("secrets") or {}).items():
    if not re.fullmatch(r"[a-z0-9_]+", name):
        sys.exit(f"[istota-stack] REFUSE: {name!r} is not a secret name")
    if value is not None and not isinstance(value, str):
        sys.exit(f"[istota-stack] REFUSE: the value for {name} is not a string")
    wanted.append((os.path.join(secrets_dir, name), name, value, 0o400))
if request.get("admins") is not None:
    wanted.append((os.path.join(config_dir, "admins"), "config/admins", request["admins"], 0o600))


def current(path):
    """The bytes and mode of a regular file at path, or None for anything else."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as fh:
        info = os.fstat(fh.fileno())
        if not stat.S_ISREG(info.st_mode):
            return None
        return fh.read(), stat.S_IMODE(info.st_mode)


changed = []
for path, label, value, mode in wanted:
    if value is None:
        try:
            if stat.S_ISREG(os.lstat(path).st_mode):
                continue
        except FileNotFoundError:
            pass
        data = b""
    else:
        data = value.encode()
        if current(path) == (data, mode):
            continue
    changed.append(label)
    if dry_run:
        continue
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".put.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            os.fchmod(fh.fileno(), mode)
        # rename(2) replaces a link at path; it never follows one.
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
verb = "would write" if dry_run else "wrote"
for label in changed:
    print(f"[istota-stack] {verb} {label}")

# A change to who manages a file is not a change to the file: it is written,
# and the exit code says nothing about it, so nothing restarts for it.
if claims:
    marker_path = os.path.join(config_dir, "managed.json")
    marker = {}
    found = current(marker_path)
    if found is not None:
        try:
            marker = json.loads(found[0])
        except ValueError:
            marker = {}
        if not isinstance(marker, dict):
            marker = {}
    updated = dict(marker)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    for resource, value in claims.items():
        entry = marker.get(resource)
        if isinstance(entry, dict) and entry.get("managed") is value and entry.get("source") == managed["source"]:
            continue
        updated[resource] = {"managed": value, "source": managed["source"], "at": stamp}
    if updated != marker:
        if dry_run:
            print("[istota-stack] would update the management marker")
        else:
            fd, tmp = tempfile.mkstemp(dir=config_dir, prefix=".put.")
            try:
                with os.fdopen(fd, "w") as fh:
                    os.fchmod(fh.fileno(), 0o600)
                    fh.write(json.dumps(updated, indent=2, sort_keys=True) + "\n")
                os.replace(tmp, marker_path)
            except BaseException:
                os.unlink(tmp)
                raise
            print("[istota-stack] updated the management marker")
sys.exit(2 if changed else 0)
'

cmd_put_files() {
    local dry_run=0
    case "${1:-}" in
        --dry-run) dry_run=1; shift ;;
    esac
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    local drop=()
    if [ "$(id -u)" -eq 0 ]; then
        drop=(setpriv "--reuid=${ISTOTA_UID}" "--regid=${ISTOTA_UID}" --clear-groups --no-new-privs)
    fi
    "${drop[@]}" python3 -I -c "$PUT_FILES_PY" "$SECRETS_DIR" "$CONFIG_DIR" "$dry_run"
}

# host.env is root's and read by provision.sh and the units; the Mac CLI
# writes the local VM's keys through this. Keys are host.env's own shape,
# upper case; nothing here restarts anything.
cmd_host_env() {
    [ "$#" -ge 1 ] || { usage >&2; exit 64; }
    local pair key
    if [ "$#" -eq 1 ] && [[ "$1" != *=* ]]; then
        case "$1" in ""|*[!A-Z0-9_]*) die "'$1' is not a host.env key" ;; esac
        env_get "$HOST_ENV" "$1"
        return 0
    fi
    for pair in "$@"; do
        key="${pair%%=*}"
        [[ "$pair" == *=* ]] || { usage >&2; exit 64; }
        case "$key" in ""|*[!A-Z0-9_]*) die "'${key}' is not a host.env key" ;; esac
    done
    file_set "$HOST_ENV" "$@"
    # As provision.sh writes it: the Mac's create on an existing VM builds a
    # signed tag before provision.sh runs.
    for pair in "$@"; do
        if [ "${pair%%=*}" = RELEASE_SIGNING_KEY ] && [ -n "${pair#*=}" ]; then
            printf 'releases namespaces="git,istota-images" %s\n' "${pair#*=}" > "$ALLOWED_SIGNERS"
            chmod 0644 "$ALLOWED_SIGNERS"
        fi
    done
}

# The release key, replaced: the only way it changes on an existing install,
# since no update writes it. Printed first, so the caller can show what it is
# about to trust. host.env is written too, or provision.sh puts the old key back.
cmd_trust_signer() {
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    local key="$1" fingerprint previous
    # A bare key line: a leading option (cert-authority, namespaces=...) would
    # widen what allowed_signers trusts. bash's =~ has no REG_NEWLINE, so a
    # line break is refused before the match, and the comment takes no control
    # character or backslash.
    local bare_key='^(ssh-[a-z0-9-]+|ecdsa-sha2-[a-z0-9-]+|sk-[a-z0-9@.-]+) [A-Za-z0-9+/]+=*( [^"\\[:cntrl:]]*)?$'
    case "$key" in
        *$'\n'*|*$'\r'*) die "trust-signer takes one line of an SSH public key; allowed_signers is unchanged." ;;
    esac
    if ! [[ "$key" =~ $bare_key ]]; then
        die "trust-signer takes one line of an SSH public key; allowed_signers is unchanged."
    fi
    fingerprint="$(printf '%s\n' "$key" | ssh-keygen -l -f - 2>/dev/null)" \
        || die "that is not an SSH public key ssh-keygen can read; allowed_signers is unchanged."
    previous="$(awk '{ $1 = ""; $2 = ""; print }' "$ALLOWED_SIGNERS" 2>/dev/null \
        | ssh-keygen -l -f - 2>/dev/null || true)"
    echo "release key: ${fingerprint}"
    [ -z "$previous" ] || echo "replacing:   ${previous}"
    cmd_host_env "RELEASE_SIGNING_KEY=${key}"
    log "releases are verified against this key from now on"
}

# Move a path the Mac CLI copied into the VM into a fresh directory under
# staging/, 0700, so the verb it is for reads it from a place no other account
# can change. A plan stays root's (apply copies it on for 10001); an export is
# 10001's, which is what import-bare-metal's one-shot container reads it as.
cmd_stage() {
    local daemon=""
    if [ "${1:-}" = --daemon ]; then daemon=1; shift; fi
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    local source="$1" name dir
    if [ -L "$source" ] || [ ! -e "$source" ]; then
        die "nothing to stage at ${source}"
    fi
    name="$(basename "$source")"
    install -d -m 0700 "$STAGING_DIR"
    dir="$(mktemp -d "${STAGING_DIR}/XXXXXXXX")"
    mv -- "$source" "${dir}/${name}"
    if [ "$(id -u)" -eq 0 ]; then
        if [ -n "$daemon" ]; then
            chown -hR "${ISTOTA_UID}:${ISTOTA_UID}" "$dir"
        else
            chown -hR 0:0 "${dir}/${name}"
        fi
    fi
    echo "${dir}/${name}"
}

# Remove the directory `stage` made for a path, and nothing outside staging/.
cmd_unstage() {
    [ "$#" -eq 1 ] || { usage >&2; exit 64; }
    local dir
    dir="$(dirname "$1")"
    case "/${dir}/" in */../*|*/./*) die "${1} is not a staged path" ;; esac
    [ "$(dirname "$dir")" = "$STAGING_DIR" ] || die "${1} is not under ${STAGING_DIR}"
    rm -rf -- "$dir"
}
# --- config-apply: the web config editor's requests ---------------------------

# Where a request's files are staged: tmpfs, so a host that dies mid-apply
# leaves no credential on disk. The override is the tests'.
CONFIG_APPLY_RUN="${ISTOTA_CONFIG_APPLY_RUN_DIR:-/run}"
CONFIG_APPLY_BACKUPS=10
# config_apply_one's exit code when nothing was pending.
CONFIG_APPLY_NOTHING=10
# What the last run that found nothing pending saw: `seen` carries the trigger
# file's mtime at its final take (absent when there was no trigger file), and
# `idle`'s own mtime is when that run ended.
CONFIG_APPLY_SEEN="${STACK}/.config-apply-seen"
CONFIG_APPLY_IDLE="${STACK}/.config-apply-idle"
CONFIG_APPLY_TRIGGER="${STACK}/requests/config-apply"
# How long an idle run stands in for asking the database again. The web
# commits a request before it writes the trigger, so only a trigger it failed
# to write waits this long.
CONFIG_APPLY_RECHECK_MINUTES=60

# Whether nothing can be pending since the last run that found nothing, so the
# timer's run need not start a container to ask.
config_apply_idle() {
    [ -f "$CONFIG_APPLY_IDLE" ] || return 1
    [ -n "$(find "$CONFIG_APPLY_IDLE" -maxdepth 0 -mmin "-${CONFIG_APPLY_RECHECK_MINUTES}" 2>/dev/null)" ] || return 1
    if [ -e "$CONFIG_APPLY_TRIGGER" ]; then
        [ -f "$CONFIG_APPLY_SEEN" ] && ! [ "$CONFIG_APPLY_TRIGGER" -nt "$CONFIG_APPLY_SEEN" ]
    else
        [ ! -e "$CONFIG_APPLY_SEEN" ]
    fi
}

# Taken before each take, so a trigger written while it runs is newer than
# what an empty take records.
config_apply_snapshot() {
    rm -f "${CONFIG_APPLY_SEEN}.next"
    if [ -e "$CONFIG_APPLY_TRIGGER" ]; then
        touch -r "$CONFIG_APPLY_TRIGGER" "${CONFIG_APPLY_SEEN}.next"
    fi
}

# The web stores a request and touches requests/config-apply; the path unit,
# or the five-minute timer, runs this. Each request: take it in a one-shot,
# check everything with both dry runs, build the image if the new config needs
# Claude Code and the image lacks it, then write credentials and admins
# (put-files) and the config (istota apply --backup), record the outcome and
# restart. Nothing is written until every check has passed. The journal gets
# verbs, ids and exit codes; the commands' own output goes to the request's
# row, through `istota config-request finish`, which redacts it again.
cmd_config_apply() {
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    # The timer runs from first boot, before setup has written anything.
    [ -f "${CONFIG_DIR}/config.toml" ] || return 0
    config_apply_idle && return 0
    if ! take_stack_lock config-apply --try; then
        log "config-apply: \`istota-stack $(lock_holder)\` holds the stack lock; the next trigger or the timer retries"
        return 0
    fi
    local rc
    rm -f "$CONFIG_APPLY_IDLE"
    while :; do
        rc=0
        config_apply_snapshot
        config_apply_one || rc=$?
        if [ "$rc" -eq "$CONFIG_APPLY_NOTHING" ]; then
            if [ -e "${CONFIG_APPLY_SEEN}.next" ]; then
                mv -f "${CONFIG_APPLY_SEEN}.next" "$CONFIG_APPLY_SEEN"
            else
                rm -f "$CONFIG_APPLY_SEEN"
            fi
            touch "$CONFIG_APPLY_IDLE"
            return 0
        elif [ "$rc" -ne 0 ]; then
            rm -f "${CONFIG_APPLY_SEEN}.next"
            log "config-apply: stopped (exit ${rc}); a request left taken is failed by the next run"
            return 1
        fi
    done
}

# Record request $1's outcome $2, with the output in staging directory $3, in a
# one-shot. A failure here leaves the row taken, which the next run's take
# marks failed.
config_apply_finish() {
    local id="$1" status="$2" dir="$3"
    if [ "$(id -u)" -eq 0 ]; then chown "$ISTOTA_UID:$ISTOTA_UID" "${dir}/output"; fi
    chmod 0400 "${dir}/output"
    log "config-apply: request ${id}: ${status}"
    oneshot -v "${dir}:/out:ro" "$(main_service)" istota config-request finish \
            --id "$id" --status "$status" --output-file /out/output >/dev/null \
        || log "config-apply: request ${id}'s outcome was not recorded; the next run marks it failed"
}

# Whether files.json names anything for put-files to write.
files_name_anything() {
    python3 -I -c 'import json, sys
request = json.load(open(sys.argv[1]))
sys.exit(0 if request.get("secrets") or request.get("admins") is not None else 1)' "$1"
}

# One request. A subshell, so the trap that removes its staging directory is
# its own: the caller's EXIT trap and the global `staging` are left alone.
# Called on the left of `||`, where bash ignores set -e, so every step that
# can fail says what then happens. Exit 0 having handled a request,
# CONFIG_APPLY_NOTHING when none was pending, anything else to stop the loop.
config_apply_one() (
    local dir out id service tag name lacking status written="" rc=0 rc_put=0 rc_apply=0 puts=""
    dir="$(mktemp -d "${CONFIG_APPLY_RUN}/istota-config.XXXXXX")" \
        || die "config-apply: could not make a staging directory in ${CONFIG_APPLY_RUN}"
    trap 'rm -rf "$dir"' EXIT
    chmod 0700 "$dir" || exit 1
    if [ "$(id -u)" -eq 0 ]; then chown "$ISTOTA_UID:$ISTOTA_UID" "$dir" || exit 1; fi
    service="$(main_service)"

    id="$(oneshot -v "${dir}:/out" "$service" istota config-request take --out /out)" \
        || { log "config-apply: take failed"; exit 1; }
    [ -n "$id" ] || exit "$CONFIG_APPLY_NOTHING"
    [[ "$id" =~ ^[0-9]+$ ]] || { log "config-apply: take answered something other than a request id"; exit 1; }
    log "config-apply: request ${id}: taken"

    # Root reads these from here on, so nothing running as 10001 may change
    # them: the directory becomes root's, which 10001 can still pass through to
    # read its own 0400 files in the later one-shots.
    if [ "$(id -u)" -eq 0 ]; then
        chown root:root "$dir" && chmod 0711 "$dir" || exit 1
    fi
    out="${dir}/output"
    : > "$out" || exit 1
    for name in plan.json files.json claude-code; do
        if [ -z "$(find -P "${dir}/${name}" -maxdepth 0 -type f 2>/dev/null)" ]; then
            echo "take left ${name} missing or not a plain file" >> "$out"
            config_apply_finish "$id" refused "$dir"
            exit 0
        fi
    done

    # Everything is checked before anything is written.
    echo "\$ istota apply --dry-run" >> "$out"
    apply_plan_file "${dir}/plan.json" --dry-run >> "$out" 2>&1 || rc=$?
    echo "(exit ${rc})" >> "$out"
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then status=refused; fi
    if files_name_anything "${dir}/files.json"; then
        puts=1
        rc=0
        echo "\$ istota-stack put-files --dry-run" >> "$out"
        cmd_put_files --dry-run < "${dir}/files.json" >> "$out" 2>&1 || rc=$?
        echo "(exit ${rc})" >> "$out"
        if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then status=refused; fi
    fi
    if [ "${status:-}" = refused ]; then
        echo "a check failed; nothing was written" >> "$out"
        config_apply_finish "$id" refused "$dir"
        exit 0
    fi

    # The image the new config needs, built before anything is written, so a
    # failed build leaves the install as it was.
    tag="$(env_get "$ENV_FILE" ISTOTA_TAG)"
    if [ "$(cat "${dir}/claude-code")" = 1 ] && [ -n "$tag" ]; then
        lacking="$(image_lacks_what_config_needs "$tag" "${dir}/plan.json")"
        if [ -n "$lacking" ]; then
            echo "${lacking}: building ${tag} with Claude Code" >> "$out"
            log "config-apply: request ${id}: building ${tag}"
            oneshot "$service" istota config-request mark --id "$id" --status building >/dev/null \
                || log "config-apply: request ${id} was not marked building"
            rc=0
            INSTALL_CLAUDE_CODE=1 build_images "$tag" >> "$out" 2>&1 || rc=$?
            if [ "$rc" -ne 0 ]; then
                tail -n 40 "$out" > "${out}.tail" && mv "${out}.tail" "$out"
                echo "the build failed (exit ${rc}); nothing was written" >> "$out"
                config_apply_finish "$id" refused "$dir"
                exit 0
            fi
        fi
    fi

    if [ -n "$puts" ]; then
        echo "\$ istota-stack put-files" >> "$out"
        cmd_put_files < "${dir}/files.json" >> "$out" 2>&1 || rc_put=$?
        echo "(exit ${rc_put})" >> "$out"
    fi
    if [ "$rc_put" -eq 0 ] || [ "$rc_put" -eq 2 ]; then
        echo "\$ istota apply --backup ${CONFIG_APPLY_BACKUPS}" >> "$out"
        apply_plan_file "${dir}/plan.json" --backup "$CONFIG_APPLY_BACKUPS" >> "$out" 2>&1 || rc_apply=$?
        echo "(exit ${rc_apply})" >> "$out"
    fi

    # A put-files that failed may have written some files before it did.
    if [ "$rc_put" -ne 0 ] && [ "$rc_put" -ne 2 ]; then
        status=failed
        written="credentials or admins, possibly"
    elif [ "$rc_apply" -ne 0 ] && [ "$rc_apply" -ne 2 ]; then
        status=failed
        if [ "$rc_put" -eq 2 ]; then written="credentials or admins"; fi
    elif [ "$rc_put" -eq 2 ] || [ "$rc_apply" -eq 2 ]; then
        status=applied
        written="the change"
    else
        status=unchanged
    fi
    if [ "$status" = failed ]; then
        echo "failed; written before the failure: ${written:-nothing}" >> "$out"
    fi
    config_apply_finish "$id" "$status" "$dir"
    # What is on disk is what runs, a partial write included, rather than
    # waiting for some later unrelated restart.
    if [ -n "$written" ]; then
        restart_for_config || log "config-apply: request ${id}: the restart failed"
    fi
    exit 0
)

cmd_up() {
    # Without a config the entrypoint refuses, and the restart policy would
    # loop on it; say what to do instead.
    [ -f "${CONFIG_DIR}/config.toml" ] || die "no ${CONFIG_DIR}/config.toml yet: set istota up first, in a browser with \`istota-stack setup --web\` or \`systemctl start istota-setup\`, or in the terminal with \`istota-stack setup\`."
    load_apparmor || die "the AppArmor profile did not load; the stack was not started."
    stack_up
    # The first certificate: nginx serves the ACME challenge on port 80 from its
    # bootstrap template until one exists, and certbot's deploy hook restarts it
    # onto the full template.
    local domain
    domain="$(env_get "$HOST_ENV" DOMAIN)"
    if [ "$(env_get "$HOST_ENV" INGRESS)" = "direct" ] \
            && [ "$(env_get "$HOST_ENV" TLS_CERT_SOURCE)" = "acme" ] \
            && [ ! -s "${STACK}/letsencrypt/live/${domain%%:*}/fullchain.pem" ] \
            && command -v systemctl >/dev/null 2>&1; then
        systemctl start --no-block istota-certbot.service || true
    fi
}

# --- retiring a bare-metal install --------------------------------------------

# Everything below the old install's paths is read under this root, for the
# tests; on a host it is empty.
RETIRE_ROOT="${ISTOTA_RETIRE_ROOT:-}"
RETIRE_DRY=""

retire_run() {
    log "  $*"
    [ -n "$RETIRE_DRY" ] || "$@"
}

retire_path() {
    local path="${RETIRE_ROOT}$1"
    if [ -e "$path" ] || [ -L "$path" ]; then
        retire_run rm -rf -- "$path"
    fi
}

# Remove what the old Ansible role installed for namespace NS, once the stack
# runs in its place: units, crons, scripts, its /etc and /var/lib directories,
# the service user and its home, its containers, volumes, networks and images,
# its host nginx site and its ufw rule for the Docker range. What the stack
# took over under the same names (mount-nextcloud.service, zram) is left.
cmd_retire_bare_metal() {
    local ns="" unit name home domain line number
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --namespace) ns="${2:-}"; shift 2 || { usage >&2; exit 64; } ;;
            --dry-run) RETIRE_DRY=1; shift ;;
            *) usage >&2; exit 64 ;;
        esac
    done
    case "$ns" in
        ""|istota|*[!a-z0-9_-]*) die "--namespace takes the old install's plain name, and it is never istota." ;;
    esac
    systemctl is-active --quiet istota-stack.service \
        || die "istota-stack.service is not active: retire the old install only once the stack runs in its place."
    for unit in scheduler web webhooks whatsapp-baileys; do
        if systemctl is-active --quiet "${ns}-${unit}.service" || systemctl is-enabled --quiet "${ns}-${unit}.service"; then
            die "${ns}-${unit}.service is still enabled or running; the export stops and disables it. Nothing was removed."
        fi
    done

    log "retiring ${ns}${RETIRE_DRY:+ (dry run, nothing removed)}:"
    for unit in scheduler web webhooks whatsapp-baileys devbox-iptables; do
        retire_path "/etc/systemd/system/${ns}-${unit}.service"
    done
    retire_path "/etc/systemd/system/${ns}-devbox-proxy@.service"
    for name in update backup browser-watchdog; do
        retire_path "/etc/cron.d/${ns}-${name}"
    done
    retire_path "/etc/logrotate.d/${ns}"
    retire_path "/etc/systemd/journald.conf.d/99-${ns}.conf"
    retire_path "/etc/tmpfiles.d/${ns}-devbox-proxy.conf"
    retire_path "/etc/tmpfiles.d/${ns}-exec.conf"
    retire_path "/etc/modules-load.d/${ns}-devbox.conf"
    retire_path "/etc/sysctl.d/99-${ns}-sandbox.conf"
    retire_path "/etc/sysctl.d/99-${ns}-devbox.conf"
    for name in "${ns}" "${ns}-run" "${ns}-backup.sh" "${ns}-browser-watchdog" "${ns}-git-credential" "${ns}-update.sh"; do
        retire_path "/usr/local/bin/${name}"
    done
    retire_path /usr/local/sbin/istota-devbox-iptables
    retire_path "/etc/${ns}"
    retire_path "/var/lib/${ns}"

    domain="$(env_get "$HOST_ENV" DOMAIN)"
    if [ -n "$domain" ] && [ -e "${RETIRE_ROOT}/etc/nginx/conf.d/${domain}.conf" ]; then
        retire_path "/etc/nginx/conf.d/${domain}.conf"
        if command -v nginx >/dev/null 2>&1; then
            if [ -n "$RETIRE_DRY" ] || nginx -t >/dev/null 2>&1; then
                retire_run systemctl reload-or-restart nginx.service
            else
                log "  nginx -t failed after removing the site; nginx was not reloaded"
            fi
        fi
    fi

    if command -v ufw >/dev/null 2>&1; then
        # Highest number first: deleting a rule renumbers the ones after it.
        ufw status numbered 2>/dev/null \
            | grep -F "# Docker containers (${ns})" \
            | sed -n 's/^\[ *\([0-9][0-9]*\)\].*/\1/p' | sort -rn \
            | while read -r number; do retire_run ufw --force delete "$number"; done
    fi

    if command -v docker >/dev/null 2>&1; then
        docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E "^${ns}-" \
            | while read -r name; do retire_run docker rm -f "$name"; done
        docker volume ls --format '{{.Name}}' 2>/dev/null | grep -E "^${ns}[-_]" \
            | while read -r name; do retire_run docker volume rm "$name"; done
        docker network ls --format '{{.Name}}' 2>/dev/null | grep -E "^${ns}[-_]" \
            | while read -r name; do retire_run docker network rm "$name"; done
        docker image ls --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -E "^${ns}-" \
            | while read -r name; do retire_run docker image rm "$name"; done
    fi

    line="$(getent passwd "$ns" || true)"
    if [ -n "$line" ]; then
        home="$(printf '%s' "$line" | cut -d: -f6)"
        # Only the role's own layout: never the stack directory, never a home
        # anywhere else.
        if [ "$home" = "/srv/app/${ns}" ] && [ "$home" != "$STACK" ]; then
            retire_run userdel "$ns"
            retire_run groupdel "$ns" || true
            retire_path "$home"
        else
            log "  the ${ns} user's home is ${home}, not /srv/app/${ns}: the user and its home are left"
        fi
    fi
    retire_run systemctl daemon-reload
    log "${ns} retired${RETIRE_DRY:+ (dry run: nothing was removed)}"
}

main() {
    local command="${1:-}"
    [ "$#" -gt 0 ] && shift
    # config-apply takes the lock itself, without waiting, and only once there
    # is a config to apply to. setup --web may hold it for an hour while it
    # waits on a browser, so it never queues either: it refuses at once.
    case "$command" in
        setup)
            case " $* " in
                *" --web "*) take_stack_lock "setup --web" --try || refuse_busy_setup_web ;;
                *) take_stack_lock setup ;;
            esac ;;
        # `up` run by release_stack_up already holds the lock: descriptor 9 is
        # inherited, and flock on it succeeds at once. The variable alone,
        # with no lock behind it, takes the lock as usual.
        up)
            if [ -z "${ISTOTA_STACK_LOCK_INHERITED:-}" ] || ! flock -n 9 2>/dev/null; then
                take_stack_lock up
            fi ;;
        # Holds the update's lock through descriptor 9 or refuses; never waits.
        update-from-checkout) ;;
        update|rollback|apply|import-bare-metal|restore|import-standalone|retire-bare-metal|put-files|localize-workspace|down|trust-signer)
            take_stack_lock "$command" ;;
        # Reading the layers' status is a read.
        local-layers)
            [ "${1:-}" = --status ] || take_stack_lock local-layers ;;
        # Setting a key writes host.env, which setup and restore write too;
        # reading one is a read. stage and unstage take none: each makes or
        # removes a directory of its own, which only the verb it is handed
        # to reads, and that verb takes the lock.
        host-env)
            case " $* " in
                *=*) take_stack_lock host-env ;;
            esac ;;
    esac
    case "$command" in
        update) cmd_update "$@" ;;
        update-from-checkout) cmd_update_from_checkout "$@" ;;
        rollback) cmd_rollback "$@" ;;
        setup) cmd_setup "$@" ;;
        setup-code) cmd_setup_code "$@" ;;
        setup-cancel) cmd_setup_cancel "$@" ;;
        apply) cmd_apply "$@" ;;
        import-bare-metal) cmd_import_bare_metal "$@" ;;
        restore) cmd_restore "$@" ;;
        import-standalone) cmd_import_standalone "$@" ;;
        retire-bare-metal) cmd_retire_bare_metal "$@" ;;
        localize-workspace) cmd_localize_workspace "$@" ;;
        put-files) cmd_put_files "$@" ;;
        config-apply) cmd_config_apply "$@" ;;
        check-image) cmd_check_image "$@" ;;
        latest-tag) cmd_latest_tag "$@" ;;
        up) cmd_up ;;
        down) compose down ;;
        exec) [ "$#" -gt 0 ] || { usage >&2; exit 64; }; stack_exec "$@" ;;
        compose) compose "$@" ;;
        host-env) cmd_host_env "$@" ;;
        trust-signer) cmd_trust_signer "$@" ;;
        local-layers) cmd_local_layers "$@" ;;
        stage) cmd_stage "$@" ;;
        unstage) cmd_unstage "$@" ;;
        -h|--help|help) usage ;;
        *) usage >&2; exit 64 ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
