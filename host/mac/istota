#!/bin/sh
# The Mac's `istota`: the VM's `istota` wrapper, reached through the Mac's
# `istota-stack` beside this file. That forwards `exec istota ...` to the VM's
# `istota-stack exec`, which runs the CLI in the daemon container through
# `istota-drop`, as uid 10001 with every capability set empty (row L4).
exec "${ISTOTA_STACK_BIN:-$(dirname "$0")/istota-stack}" exec istota "$@"
